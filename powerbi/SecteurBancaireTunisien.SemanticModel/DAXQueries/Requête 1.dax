EVALUATE
SELECTCOLUMNS (
    Dim_Banque,
    "banque", Dim_Banque[code_banque],
    "liquidite", Dim_Banque[Liquidite_Titre],
    "charges operatoires", Dim_Banque[Definition_Charges_Operatoires],
    "capitaux propres", Dim_Banque[Definition_Capitaux_Propres]
)
ORDER BY [banque]

EVALUATE
SUMMARIZECOLUMNS (
    Journal_Faits_Marquants[type_fait],
    "Nb faits", [Nb faits marquants]
)
ORDER BY Journal_Faits_Marquants[type_fait]

EVALUATE
ROW (
    "Top 3 PNB 2024T3", CALCULATE ( [Top 3 banques PNB], Dim_Date[Annee_Trimestre] = "2024T3" ),
    "Part 3 premieres 2024T3", CALCULATE ( [Part 3 premieres banques PNB], Dim_Date[Annee_Trimestre] = "2024T3" ),
    "Changements (tout)", [Changements actionnaire],
    "Changements 2021", CALCULATE ( [Changements actionnaire], Dim_Date[Annee] = 2021 ),
    "Changements 2023 (vide attendu)", CALCULATE ( [Changements actionnaire], Dim_Date[Annee] = 2023 ),
    "Detail 2024", CALCULATE ( [Changements actionnaire detail], Dim_Date[Annee] = 2024 ),
    "Nb faits marquants 2020", CALCULATE ( [Nb faits marquants], Dim_Date[Annee] = 2020 )
)