EVALUATE
SUMMARIZECOLUMNS (
    Dim_Banque[code_banque],
    TREATAS ( { "2024T3" }, Dim_Date[Annee_Trimestre] ),
    "Coef harmonise", [Coef exploitation harmonise],
    "Rang coef", [Rang coef],
    "Ecart / mediane", [Ecart coef / mediane],
    "Coef publie", [Coef exploitation publie],
    "Part marge interets", [Part marge interets],
    "Part commissions", [Part commissions],
    "Part portefeuille", [Part portefeuille],
    "Frais personnel / PNB", [Frais personnel / PNB],
    "Credits / Depots", [Credits / Depots],
    "Part depots a vue", [Part depots a vue]
)
ORDER BY [Rang coef]

EVALUATE
ROW (
    "Banques presentes coef 2024T3", CALCULATE ( [Banques presentes coef], Dim_Date[Annee_Trimestre] = "2024T3" ),
    "Coef secteur 2024T3", CALCULATE ( [Coef secteur], Dim_Date[Annee_Trimestre] = "2024T3" ),
    "Coef mediane 2024T3", CALCULATE ( [Coef mediane], Dim_Date[Annee_Trimestre] = "2024T3" ),
    "Coef harmonise 2024 (vide attendu)", CALCULATE ( [Coef exploitation harmonise], Dim_Date[Annee] = 2024 ),
    "Coef harmonise annuel 2024 secteur", CALCULATE ( [Coef exploitation harmonise annuel], Dim_Date[Annee] = 2024 )
)

EVALUATE
SUMMARIZECOLUMNS (
    Dim_Banque[code_banque],
    TREATAS ( { 2024 }, Dim_Date[Annee] ),
    "Coef harmonise annuel", [Coef exploitation harmonise annuel]
)
ORDER BY Dim_Banque[code_banque]