model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["CheminDonnees","AdresseDepot","Fichiers_Donnees","Versions","Dim_Indicateur","Fait_Indicateurs","Revisions","Banques_Actionnariat","Dim_Banque","Operations_Titres","Evenements","Fait_Cours","Variations_Comparables","Fait_Etats_Financiers","Revisions_Etats_Financiers","Controle","Ecarts_Annuels","Controle_Annuel"]

ref table Fait_Indicateurs
ref table Dim_Indicateur
ref table Revisions
ref table Banques_Actionnariat
ref table Dim_Banque
ref table Evenements
ref table Fait_Cours
ref table Variations_Comparables
ref table Fait_Etats_Financiers
ref table Revisions_Etats_Financiers
ref table Controle
ref table Controle_Annuel

ref cultureInfo fr-FR

