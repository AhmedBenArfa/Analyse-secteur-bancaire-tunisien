/// Contrôle annuel : somme des 4 trimestres retenus contre cumul annuel retenu, statut en clair et cause de chaque écart (page qualité)
table Controle_Annuel
	lineageTag: fc3fe072-7ffe-45dd-9af7-061b4645c365

	column banque
		dataType: string
		lineageTag: f472e35e-1768-41f8-9127-52ecf86ffd81
		summarizeBy: none
		sourceColumn: banque

		annotation SummarizationSetBy = User

	column annee
		dataType: int64
		formatString: 0
		lineageTag: f0ca05e2-e41a-4631-88f9-f7b4a5d039b4
		summarizeBy: none
		sourceColumn: annee

		annotation SummarizationSetBy = User

	column code_indicateur
		dataType: string
		lineageTag: 07c919b8-ead0-4cbc-b772-7d1628513357
		summarizeBy: none
		sourceColumn: code_indicateur

		annotation SummarizationSetBy = User

	column somme_trimestres
		dataType: double
		lineageTag: 63b1eadb-d107-42fd-9981-dee0935557e2
		summarizeBy: none
		sourceColumn: somme_trimestres

