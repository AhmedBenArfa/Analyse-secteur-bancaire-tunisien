	column Ecart_MDT
		dataType: double
		lineageTag: 426f2cc1-1240-469c-83a2-ababb4eab520
		summarizeBy: none
		sourceColumn: Ecart_MDT

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column date_arrete
