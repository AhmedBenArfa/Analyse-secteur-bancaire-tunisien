/// Table de faits des états financiers (comptes individuels, 30/06 et 31/12) : résultat net, total de l actif, capitaux propres du bilan, valeur retenue, source, facteur d annualisation
table Fait_Etats_Financiers
	lineageTag: 8e1c7e62-1a5e-4bad-b92b-0420dfce51d2

	column banque
		dataType: string
		lineageTag: b0e44ea7-5796-475c-a202-4301b2e48fec
		summarizeBy: none
		sourceColumn: banque

		annotation SummarizationSetBy = User

	column date_arrete
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7469371e-a048-426d-8204-ea9dab111f0e
		summarizeBy: none
		sourceColumn: date_arrete

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column type
		dataType: string
		lineageTag: 29745b13-5047-4bd7-9c07-08d90046f2fb
		summarizeBy: none
		sourceColumn: type

