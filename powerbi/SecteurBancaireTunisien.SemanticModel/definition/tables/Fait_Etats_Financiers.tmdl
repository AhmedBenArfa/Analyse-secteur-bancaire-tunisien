		lineageTag: 79a1bdd0-808e-4d02-9808-ebab69715231
		summarizeBy: none
		sourceColumn: code

		annotation SummarizationSetBy = User

	column valeur_mdt
		dataType: double
		lineageTag: 272fc0a5-d81e-47ac-96c6-452c8ff656ad
		summarizeBy: none
		sourceColumn: valeur_mdt

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column version
