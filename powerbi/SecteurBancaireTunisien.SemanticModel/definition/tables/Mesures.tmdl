/// Mesures DAX du rapport (dax/mesures.dax), rangées par dossier
table Mesures
	lineageTag: efa45667-b404-4cb3-8b89-e41cd9c44144

	/// Somme des valeurs retenues du trimestre seul ; vide si la sélection couvre plusieurs dates d'arrêté (jamais la somme de plusieurs trimestres)
	measure 'Valeur Trim' = IF ( DISTINCTCOUNT ( Fait_Indicateurs[date_arrete] ) = 1, SUM ( Fait_Indicateurs[Valeur_Trim] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 2651b576-b937-4b3e-867e-1ddc7b3f816b

	/// Somme des valeurs retenues du cumul depuis janvier (flux) ou du solde (stock) ; vide si la sélection couvre plusieurs dates d'arrêté
	measure 'Valeur Cumul' = IF ( DISTINCTCOUNT ( Fait_Indicateurs[date_arrete] ) = 1, SUM ( Fait_Indicateurs[Valeur_Cumul] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: c7a262a7-b93a-449c-b1ab-b6969616f48b

	/// Produit net bancaire du trimestre seul (MDT)
	measure PNB = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "PNB" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 24a7c969-1d19-4274-8a93-c206038235c2

	/// Charges opératoires publiées du trimestre (contenu propre à chaque banque : Definitions_Charges)
	measure 'Charges operatoires' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "CHG_OPER" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 654feed3-d9c2-410b-aa64-5c745a063224

	/// Frais de personnel du trimestre
	measure 'Frais personnel' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "FRAIS_PERS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: ba9bb69e-fb0f-4ff1-8b47-11582a7174b9

	/// Charges générales d'exploitation du trimestre
	measure 'Charges generales' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "CHG_GEN" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: a8fed403-de09-4ebb-a40a-b391643c5da4

	/// Intérêts perçus − intérêts encourus du trimestre ; vide si l'un des deux manque (un vide n'est jamais lu comme zéro)
	measure 'Marge interets' =
			VAR Percus = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "INT_PERCUS" )
			VAR Encourus = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "INT_ENCOURUS" )
			RETURN
			    IF ( NOT ISBLANK ( Percus ) && NOT ISBLANK ( Encourus ), Percus - Encourus )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 9c121d53-a472-418a-bbb2-5b7af21e7c97

	/// Commissions en produits − commissions encourues du trimestre ; vide si l'une des deux manque
	measure 'Marge commissions' =
			VAR Produits = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "COMM_PROD" )
			VAR Charges = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "COMM_CHG" )
			RETURN
			    IF ( NOT ISBLANK ( Produits ) && NOT ISBLANK ( Charges ), Produits - Charges )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: d5605fbc-08c6-42f2-8b2e-8415a3ec4ba8

	/// Revenus du portefeuille-titres du trimestre
	measure 'Revenus portefeuille' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "REV_PORTEF" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 7541328b-6439-4edb-817c-b5d5c7ec86fe

	/// PNB cumulé depuis janvier à une date d'arrêté
	measure 'PNB cumul brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "PNB" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 54cc4c27-92d2-42b3-80c3-1ce7b9b4fb4f

	/// PNB cumulé publié au dernier trimestre de la sélection qui a une valeur (jamais la somme des trimestres)
	measure 'PNB depuis debut annee' = CALCULATE ( [PNB cumul brut], LASTNONBLANK ( Dim_Date[Date], [PNB cumul brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux cumulés
		lineageTag: 6b7d9094-3c83-4623-bafd-7400f00baa5a

	/// PNB de l'année : cumul publié au 31/12 ; vide pour une année sans T4 publié ou si plusieurs années sont sélectionnées
	measure 'PNB annuel' = CALCULATE ( [PNB cumul brut], Dim_Date[Trimestre] = "T4" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux cumulés
		lineageTag: d8bc00e0-3f27-4d75-9fc9-5e0135725dac

	/// Encours des crédits à une date d'arrêté
	measure 'Credits brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CREDITS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 505ca9f4-70f3-43b9-a786-83af9cbbbd31

	/// Encours des crédits à la dernière date de la sélection qui a une valeur (jamais additionné dans le temps)
	measure Credits = CALCULATE ( [Credits brut], LASTNONBLANK ( Dim_Date[Date], [Credits brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: 0689f863-cad5-4b7c-a529-48806c3ed71c

	/// Encours des dépôts à une date d'arrêté
	measure 'Depots brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEPOTS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 66f35591-7d4d-4db4-985a-798940734dfd

	/// Encours des dépôts de la clientèle à la dernière date de la sélection qui a une valeur
	measure Depots = CALCULATE ( [Depots brut], LASTNONBLANK ( Dim_Date[Date], [Depots brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: b7c635be-dcf9-4955-81e1-8d0262ecf7b1

	/// Dépôts à vue à une date d'arrêté
	measure 'Depots a vue brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_VUE" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: a9c07d0b-e4ee-4d38-ad44-b252189d8b13

	/// Dépôts à vue à la dernière date de la sélection qui a une valeur
	measure 'Depots a vue' = CALCULATE ( [Depots a vue brut], LASTNONBLANK ( Dim_Date[Date], [Depots a vue brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: 0e37f5ac-ea00-454f-8708-f15fd0a14c21

	/// Dépôts d'épargne à une date d'arrêté
	measure 'Depots epargne brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_EPARGNE" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 7421d4fa-8f40-4b8b-ab9a-905b2e1639a4

	/// Dépôts d'épargne à la dernière date de la sélection qui a une valeur
	measure 'Depots epargne' = CALCULATE ( [Depots epargne brut], LASTNONBLANK ( Dim_Date[Date], [Depots epargne brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: d71dc6e3-15f5-4b9a-a89c-9ac76113a68a

	/// Dépôts à terme à une date d'arrêté (publiés par une partie des banques seulement)
	measure 'Depots terme brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_TERME" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: be07326f-0eb8-45c5-8aef-4fdc6fd26b51

	/// Dépôts à terme à la dernière date de la sélection qui a une valeur (publiés par une partie des banques seulement)
	measure 'Depots terme' = CALCULATE ( [Depots terme brut], LASTNONBLANK ( Dim_Date[Date], [Depots terme brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: e64edca7-b666-49d9-ad98-a30b5d57738f

	/// Emprunts et ressources spéciales à une date d'arrêté
	measure 'Emprunts brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "EMPRUNTS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 698824b9-30db-48eb-b29d-3f3483a71bf9

	/// Emprunts et ressources spéciales à la dernière date de la sélection qui a une valeur
	measure Emprunts = CALCULATE ( [Emprunts brut], LASTNONBLANK ( Dim_Date[Date], [Emprunts brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: 26cfab42-7e4b-4b8a-8231-9b7116ceacfd

	/// Capitaux propres trimestriels à une date d'arrêté (définition propre à chaque banque)
	measure 'Capitaux propres hors resultat brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CAP_PROPRES" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 47f2b19c-b4ae-4d55-84aa-afd0d50f8fd4

	/// Capitaux propres trimestriels publiés : FICHE BANQUE SEULEMENT, avec Definitions_Capitaux_Propres ; les comparaisons entre banques utilisent les capitaux propres du bilan (7.7)
	measure 'Capitaux propres hors resultat de la periode' =
			CALCULATE (
			    [Capitaux propres hors resultat brut],
			    LASTNONBLANK ( Dim_Date[Date], [Capitaux propres hors resultat brut] )
			)
		formatString: #,0.000
		displayFolder: 1. Bases\Fiche banque
		lineageTag: 4377c99a-f0e9-434b-bbbb-37b03a1b7212

	/// Nombre de banques du modèle (12)
	measure 'Nombre de banques' = COUNTROWS ( ALL ( Dim_Banque ) )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 4d950711-a56b-4a23-be7e-f54244785df7

	/// Nombre de banques qui ont un PNB du trimestre pour la sélection (toutes banques confondues, filtre de banque ignoré)
	measure 'Banques presentes PNB' = COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [PNB] ) ) )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: d015e47e-90fa-40ae-9aba-a34a7c3d2969

	/// Dernière date d'arrêté de la sélection où au moins une banque a un encours de crédits
	measure 'Date fin credits' =
			CALCULATE (
			    MAX ( Fait_Indicateurs[date_arrete] ),
			    REMOVEFILTERS ( Dim_Banque ),
			    Dim_Indicateur[code_indicateur] = "CREDITS",
			    NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
			)
		formatString: Short Date
		displayFolder: 2. Secteur\Intermédiaires
		lineageTag: f9987cb8-f7e9-42e0-95db-ad3b0aae8dcb

	/// Nombre de banques qui ont un encours de crédits à la dernière date de la sélection
	measure 'Banques presentes credits' =
			VAR DateFin = [Date fin credits]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Credits brut] ) ) ),
			        REMOVEFILTERS ( Dim_Date ),
			        Dim_Date[Date] = DateFin
			    )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 0ee13b6a-eaf9-40af-9310-ae80bb19cc0e

	/// Dernière date d'arrêté de la sélection où au moins une banque a un encours de dépôts
	measure 'Date fin depots' =
			CALCULATE (
			    MAX ( Fait_Indicateurs[date_arrete] ),
			    REMOVEFILTERS ( Dim_Banque ),
			    Dim_Indicateur[code_indicateur] = "DEPOTS",
			    NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
			)
		formatString: Short Date
		displayFolder: 2. Secteur\Intermédiaires
		lineageTag: 9fa8a5d8-52ea-4bfd-a41e-366a10b735c4

	/// Nombre de banques qui ont un encours de dépôts à la dernière date de la sélection
	measure 'Banques presentes depots' =
			VAR DateFin = [Date fin depots]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Depots brut] ) ) ),
			        REMOVEFILTERS ( Dim_Date ),
			        Dim_Date[Date] = DateFin
			    )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 95e9668e-e389-4ef1-a189-7a7e3e08a969

	/// Nombre de banques qui ont une valeur (cumul ou solde) pour l'indicateur choisi à la date sélectionnée ; vide si aucun ou plusieurs indicateurs sont choisis
	measure 'Banques presentes' =
			IF (
			    HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
			    COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Valeur Cumul] ) ) )
			)
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 87eb6a28-4df8-4528-a306-f43e85b6ff69

	/// PNB du trimestre des 12 banques ; vide si une banque manque
	measure 'PNB secteur' =
			IF (
			    [Banques presentes PNB] = [Nombre de banques],
			    CALCULATE ( [PNB], REMOVEFILTERS ( Dim_Banque ) )
			)
		formatString: #,0.000
		displayFolder: 2. Secteur\Totaux
		lineageTag: e538ba6b-082d-44ad-819c-a548b1ac7162

	/// Encours de crédits des 12 banques à la dernière date de la sélection ; vide si une banque manque à cette date
	measure 'Credits secteur' =
			VAR DateFin = [Date fin credits]
			RETURN
			    IF (
			        [Banques presentes credits] = [Nombre de banques],
			        CALCULATE ( [Credits brut], REMOVEFILTERS ( Dim_Banque ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
			    )
		formatString: #,0.000
		displayFolder: 2. Secteur\Totaux
		lineageTag: 8548e2a0-5eb4-4c3d-b1eb-fa70dfe9d368

	/// Encours de dépôts des 12 banques à la dernière date de la sélection ; vide si une banque manque à cette date
	measure 'Depots secteur' =
			VAR DateFin = [Date fin depots]
			RETURN
			    IF (
			        [Banques presentes depots] = [Nombre de banques],
			        CALCULATE ( [Depots brut], REMOVEFILTERS ( Dim_Banque ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
			    )
		formatString: #,0.000
		displayFolder: 2. Secteur\Totaux
		lineageTag: 79b5301f-435b-4c51-8a53-01720e06ea80

	/// Part de la banque dans le PNB du trimestre des 12 banques
	measure 'Part de marche PNB' = DIVIDE ( [PNB], [PNB secteur] )
		formatString: 0.00 %
		displayFolder: 2. Secteur\Parts de marché
		lineageTag: 66e17236-908e-4f1f-9f5d-6083c83b74b9

	/// Part de la banque dans l'encours de crédits des 12 banques
	measure 'Part de marche credits' = DIVIDE ( [Credits], [Credits secteur] )
		formatString: 0.00 %
		displayFolder: 2. Secteur\Parts de marché
		lineageTag: f5e0e093-aa82-4782-a85e-3923ca6b0109

	/// Part de la banque dans l'encours de dépôts des 12 banques
	measure 'Part de marche depots' = DIVIDE ( [Depots], [Depots secteur] )
		formatString: 0.00 %
		displayFolder: 2. Secteur\Parts de marché
		lineageTag: 61e9d957-6a3a-48cb-af22-f667d5c26594

	/// Indice de Herfindahl-Hirschman du PNB : somme des carrés des parts de marché × 10 000 (de 833 si les 12 banques étaient égales à 10 000 pour une seule banque) ; vide si une banque manque
	measure 'HHI PNB' =
			IF (
			    NOT ISBLANK ( [PNB secteur] ),
			    SUMX ( ALL ( Dim_Banque ), [Part de marche PNB] ^ 2 ) * 10000
			)
		formatString: #,0
		displayFolder: 2. Secteur\Concentration
		lineageTag: 584dc97c-6650-463b-a79e-570ceb8a3bb3

	/// Rang de la banque par PNB du trimestre (1 = le plus élevé) ; vide hors d'une ligne de banque ou si une banque manque
	measure 'Rang PNB' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] ) && NOT ISBLANK ( [PNB] ) && NOT ISBLANK ( [PNB secteur] ),
			    RANKX ( ALL ( Dim_Banque ), [PNB], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 2. Secteur\Rangs
		lineageTag: 76443ff9-961f-461a-9060-55231054c44d

	/// Dernier trimestre où les 12 banques ont publié PNB, crédits et dépôts (colonne Choix_Trimestre de Dim_Date), par exemple « 2026T3 »
	measure 'Dernier trimestre complet' =
			CALCULATE (
			    SELECTEDVALUE ( Dim_Date[Annee_Trimestre] ),
			    REMOVEFILTERS ( Dim_Date ),
			    Dim_Date[Choix_Trimestre] = "Dernier trimestre complet"
			)
		displayFolder: 2. Secteur\Dernier trimestre complet
		lineageTag: e1072f8e-30f4-4927-a267-2c879f6468ef

	/// Date d'arrêté du dernier trimestre complet
	measure 'Date dernier trimestre complet' =
			CALCULATE (
			    MAX ( Dim_Date[Date] ),
			    REMOVEFILTERS ( Dim_Date ),
			    Dim_Date[Choix_Trimestre] = "Dernier trimestre complet"
			)
		formatString: Short Date
		displayFolder: 2. Secteur\Dernier trimestre complet
		lineageTag: d7148d63-af80-4826-8fe9-4a917b45d5ba

	/// Coefficient publié = charges opératoires publiées / PNB du trimestre ; POUR INFORMATION (le contenu des charges opératoires varie d'une banque à l'autre : Definitions_Charges), jamais classé
	measure 'Coef exploitation publie' = DIVIDE ( [Charges operatoires], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Coefficient d'exploitation
		lineageTag: 32e55846-9677-4dbc-9c0c-46e30edc413f

	/// Coefficient harmonisé = (frais de personnel + charges générales) / PNB du trimestre, sur les banques qui publient les trois montants ; sert à toutes les comparaisons et classements
	measure 'Coef exploitation harmonise' =
			VAR Lignes =
			    ADDCOLUMNS (
			        VALUES ( Dim_Banque[code_banque] ),
			        "@Pers", [Frais personnel],
			        "@Gen", [Charges generales],
			        "@PNB", [PNB]
			    )
			VAR Completes =
			    FILTER ( Lignes, NOT ISBLANK ( [@Pers] ) && NOT ISBLANK ( [@Gen] ) && NOT ISBLANK ( [@PNB] ) )
			RETURN
			    DIVIDE ( SUMX ( Completes, [@Pers] + [@Gen] ), SUMX ( Completes, [@PNB] ) )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Coefficient d'exploitation
		lineageTag: 5972de1e-013f-452d-89dd-c3dd192cb679

	/// Frais de personnel de l'année : cumul publié au 31/12
	measure 'Frais personnel annuel' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "FRAIS_PERS", Dim_Date[Trimestre] = "T4" )
		formatString: #,0.000
		displayFolder: 3. Ratios\Intermédiaires
		lineageTag: e3621bf7-8ca9-441a-be6d-e66b503ef63f

	/// Charges générales d'exploitation de l'année : cumul publié au 31/12
	measure 'Charges generales annuel' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CHG_GEN", Dim_Date[Trimestre] = "T4" )
		formatString: #,0.000
		displayFolder: 3. Ratios\Intermédiaires
		lineageTag: 8e86718d-773e-4a67-8439-3f18d5d97e7e

	/// Coefficient harmonisé de l'année, à partir des cumuls publiés au 31/12 (jamais la somme des trimestres) ; vide pour une année sans T4 publié
	measure 'Coef exploitation harmonise annuel' =
			VAR Lignes =
			    ADDCOLUMNS (
			        VALUES ( Dim_Banque[code_banque] ),
			        "@Pers", [Frais personnel annuel],
			        "@Gen", [Charges generales annuel],
			        "@PNB", [PNB annuel]
			    )
			VAR Completes =
			    FILTER ( Lignes, NOT ISBLANK ( [@Pers] ) && NOT ISBLANK ( [@Gen] ) && NOT ISBLANK ( [@PNB] ) )
			RETURN
			    DIVIDE ( SUMX ( Completes, [@Pers] + [@Gen] ), SUMX ( Completes, [@PNB] ) )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Coefficient d'exploitation
		lineageTag: 4e9f9ab5-f5df-4f96-b5ed-2b36733a3a57

	/// Nombre de banques qui publient frais de personnel, charges générales et PNB pour le trimestre sélectionné
	measure 'Banques presentes coef' =
			COUNTROWS (
			    FILTER (
			        ALL ( Dim_Banque ),
			        NOT ISBLANK ( [Frais personnel] ) && NOT ISBLANK ( [Charges generales] ) && NOT ISBLANK ( [PNB] )
			    )
			)
		formatString: 0
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: 2a10b6a0-a3a7-44b2-97fa-29b5f8980f19

	/// Coefficient harmonisé du secteur (moyenne pondérée par le PNB : somme des charges / somme des PNB des 12 banques) ; vide si une banque manque
	measure 'Coef secteur' =
			IF (
			    [Banques presentes coef] = [Nombre de banques],
			    CALCULATE ( [Coef exploitation harmonise], REMOVEFILTERS ( Dim_Banque ) )
			)
		formatString: 0.0 %
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: e1129c7a-09ce-47e9-8e14-8037ea0e1d8e

	/// Médiane des coefficients harmonisés des 12 banques (banque « du milieu », insensible aux extrêmes) ; vide si une banque manque
	measure 'Coef mediane' =
			IF (
			    [Banques presentes coef] = [Nombre de banques],
			    MEDIANX ( ALL ( Dim_Banque ), [Coef exploitation harmonise] )
			)
		formatString: 0.0 %
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: 66d81358-c661-43e8-a333-25d00a3248e4

	/// Écart du coefficient harmonisé de la banque à la médiane (négatif = plus efficace que la banque médiane) ; vide hors d'une ligne de banque
	measure 'Ecart coef / mediane' =
			VAR Coef = [Coef exploitation harmonise]
			VAR Mediane = [Coef mediane]
			RETURN
			    IF (
			        HASONEVALUE ( Dim_Banque[code_banque] ) && NOT ISBLANK ( Coef ) && NOT ISBLANK ( Mediane ),
			        Coef - Mediane
			    )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: ddbc5e6f-ba4a-40c7-b1f7-a924f7558441

	/// Rang du coefficient harmonisé (1 = le plus bas, donc la banque la plus efficace) ; vide hors d'une ligne de banque ou si une banque manque
	measure 'Rang coef' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] )
			        && NOT ISBLANK ( [Coef exploitation harmonise] )
			        && [Banques presentes coef] = [Nombre de banques],
			    RANKX ( ALL ( Dim_Banque ), [Coef exploitation harmonise], , ASC, DENSE )
			)
		formatString: 0
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: aa68b87e-45c9-4e25-be43-0233f33c9c54

	/// Marge d'intérêts / PNB du trimestre
	measure 'Part marge interets' = DIVIDE ( [Marge interets], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: 11e8fe2e-9e02-4d3a-9f50-78bc6362a75a

	/// Marge sur commissions / PNB du trimestre
	measure 'Part commissions' = DIVIDE ( [Marge commissions], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: fadca509-b188-466e-a03e-66c8c87507e7

	/// Revenus du portefeuille-titres / PNB du trimestre
	measure 'Part portefeuille' = DIVIDE ( [Revenus portefeuille], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: a2c62407-cf52-4a79-a6c3-27f97640c418

	/// Frais de personnel / PNB du trimestre
	measure 'Frais personnel / PNB' = DIVIDE ( [Frais personnel], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: 2f4cd4a1-36e9-4779-871b-72b1c2ca3d26

	/// Encours des crédits / encours des dépôts en fin de période (plus de 100 % : la banque prête plus qu'elle ne collecte de dépôts)
	measure 'Credits / Depots' = DIVIDE ( [Credits], [Depots] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Bilan
		lineageTag: 59af4594-1963-4699-81fe-9f1e69917edf

	/// Dépôts à vue / total des dépôts en fin de période (ressources peu coûteuses)
	measure 'Part depots a vue' = DIVIDE ( [Depots a vue], [Depots] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Bilan
		lineageTag: 19e949ba-3af9-42a9-8a24-00117e43994f

