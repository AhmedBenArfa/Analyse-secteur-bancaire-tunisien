/// Mesures DAX du rapport (dax/mesures.dax), rangées par dossier
table Mesures
	lineageTag: efa45667-b404-4cb3-8b89-e41cd9c44144

	/// Somme des valeurs retenues du trimestre seul ; vide si la sélection couvre plusieurs dates d'arrêté (jamais la somme de plusieurs trimestres)
	measure 'Valeur Trim' = IF ( DISTINCTCOUNT ( Fait_Indicateurs[date_arrete] ) = 1, SUM ( Fait_Indicateurs[Valeur_Trim] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 2651b576-b937-4b3e-867e-1ddc7b3f816b

	/// Somme des valeurs retenues du cumul depuis janvier (flux) ou du solde (stock) ; vide si la sélection couvre plusieurs dates d'arrêté
	measure 'Valeur Cumul' = IF ( DISTINCTCOUNT ( Fait_Indicateurs[date_arrete] ) = 1, SUM ( Fait_Indicateurs[Valeur_Cumul] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: c7a262a7-b93a-449c-b1ab-b6969616f48b

	/// Produit net bancaire du trimestre seul (MDT)
	measure PNB = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "PNB" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 24a7c969-1d19-4274-8a93-c206038235c2

	/// Charges opératoires publiées du trimestre (contenu propre à chaque banque : Definitions_Charges)
	measure 'Charges operatoires' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "CHG_OPER" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 654feed3-d9c2-410b-aa64-5c745a063224

	/// Frais de personnel du trimestre
	measure 'Frais personnel' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "FRAIS_PERS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: ba9bb69e-fb0f-4ff1-8b47-11582a7174b9

	/// Charges générales d'exploitation du trimestre
	measure 'Charges generales' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "CHG_GEN" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: a8fed403-de09-4ebb-a40a-b391643c5da4

	/// Intérêts perçus − intérêts encourus du trimestre ; vide si l'un des deux manque (un vide n'est jamais lu comme zéro)
	measure 'Marge interets' =
			VAR Percus = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "INT_PERCUS" )
			VAR Encourus = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "INT_ENCOURUS" )
			RETURN
			    IF ( NOT ISBLANK ( Percus ) && NOT ISBLANK ( Encourus ), Percus - Encourus )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 9c121d53-a472-418a-bbb2-5b7af21e7c97

	/// Commissions en produits − commissions encourues du trimestre ; vide si l'une des deux manque
	measure 'Marge commissions' =
			VAR Produits = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "COMM_PROD" )
			VAR Charges = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "COMM_CHG" )
			RETURN
			    IF ( NOT ISBLANK ( Produits ) && NOT ISBLANK ( Charges ), Produits - Charges )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: d5605fbc-08c6-42f2-8b2e-8415a3ec4ba8

	/// Revenus du portefeuille-titres du trimestre
	measure 'Revenus portefeuille' = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "REV_PORTEF" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux du trimestre
		lineageTag: 7541328b-6439-4edb-817c-b5d5c7ec86fe

	/// PNB cumulé depuis janvier à une date d'arrêté
	measure 'PNB cumul brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "PNB" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 54cc4c27-92d2-42b3-80c3-1ce7b9b4fb4f

	/// PNB cumulé publié au dernier trimestre de la sélection qui a une valeur (jamais la somme des trimestres)
	measure 'PNB depuis debut annee' = CALCULATE ( [PNB cumul brut], LASTNONBLANK ( Dim_Date[Date], [PNB cumul brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux cumulés
		lineageTag: 6b7d9094-3c83-4623-bafd-7400f00baa5a

	/// PNB de l'année : cumul publié au 31/12 ; vide pour une année sans T4 publié ou si plusieurs années sont sélectionnées
	measure 'PNB annuel' = CALCULATE ( [PNB cumul brut], Dim_Date[Trimestre] = "T4" )
		formatString: #,0.000
		displayFolder: 1. Bases\Flux cumulés
		lineageTag: d8bc00e0-3f27-4d75-9fc9-5e0135725dac

	/// Encours des crédits à une date d'arrêté
	measure 'Credits brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CREDITS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 505ca9f4-70f3-43b9-a786-83af9cbbbd31

	/// Encours des crédits à la dernière date de la sélection qui a une valeur (jamais additionné dans le temps)
	measure Credits = CALCULATE ( [Credits brut], LASTNONBLANK ( Dim_Date[Date], [Credits brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: 0689f863-cad5-4b7c-a529-48806c3ed71c

	/// Encours des dépôts à une date d'arrêté
	measure 'Depots brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEPOTS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 66f35591-7d4d-4db4-985a-798940734dfd

	/// Encours des dépôts de la clientèle à la dernière date de la sélection qui a une valeur
	measure Depots = CALCULATE ( [Depots brut], LASTNONBLANK ( Dim_Date[Date], [Depots brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: b7c635be-dcf9-4955-81e1-8d0262ecf7b1

	/// Dépôts à vue à une date d'arrêté
	measure 'Depots a vue brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_VUE" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: a9c07d0b-e4ee-4d38-ad44-b252189d8b13

	/// Dépôts à vue à la dernière date de la sélection qui a une valeur
	measure 'Depots a vue' = CALCULATE ( [Depots a vue brut], LASTNONBLANK ( Dim_Date[Date], [Depots a vue brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: 0e37f5ac-ea00-454f-8708-f15fd0a14c21

	/// Dépôts d'épargne à une date d'arrêté
	measure 'Depots epargne brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_EPARGNE" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 7421d4fa-8f40-4b8b-ab9a-905b2e1639a4

	/// Dépôts d'épargne à la dernière date de la sélection qui a une valeur
	measure 'Depots epargne' = CALCULATE ( [Depots epargne brut], LASTNONBLANK ( Dim_Date[Date], [Depots epargne brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: d71dc6e3-15f5-4b9a-a89c-9ac76113a68a

	/// Dépôts à terme à une date d'arrêté (publiés par une partie des banques seulement)
	measure 'Depots terme brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_TERME" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: be07326f-0eb8-45c5-8aef-4fdc6fd26b51

	/// Dépôts à terme à la dernière date de la sélection qui a une valeur (publiés par une partie des banques seulement)
	measure 'Depots terme' = CALCULATE ( [Depots terme brut], LASTNONBLANK ( Dim_Date[Date], [Depots terme brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: e64edca7-b666-49d9-ad98-a30b5d57738f

	/// Emprunts et ressources spéciales à une date d'arrêté
	measure 'Emprunts brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "EMPRUNTS" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 698824b9-30db-48eb-b29d-3f3483a71bf9

	/// Emprunts et ressources spéciales à la dernière date de la sélection qui a une valeur
	measure Emprunts = CALCULATE ( [Emprunts brut], LASTNONBLANK ( Dim_Date[Date], [Emprunts brut] ) )
		formatString: #,0.000
		displayFolder: 1. Bases\Encours
		lineageTag: 26cfab42-7e4b-4b8a-8231-9b7116ceacfd

	/// Capitaux propres trimestriels à une date d'arrêté (définition propre à chaque banque)
	measure 'Capitaux propres hors resultat brut' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CAP_PROPRES" )
		formatString: #,0.000
		displayFolder: 1. Bases\Intermédiaires
		lineageTag: 47f2b19c-b4ae-4d55-84aa-afd0d50f8fd4

	/// Capitaux propres trimestriels publiés : FICHE BANQUE SEULEMENT, avec Definitions_Capitaux_Propres ; les comparaisons entre banques utilisent les capitaux propres du bilan (7.7)
	measure 'Capitaux propres hors resultat de la periode' =
			CALCULATE (
			    [Capitaux propres hors resultat brut],
			    LASTNONBLANK ( Dim_Date[Date], [Capitaux propres hors resultat brut] )
			)
		formatString: #,0.000
		displayFolder: 1. Bases\Fiche banque
		lineageTag: 4377c99a-f0e9-434b-bbbb-37b03a1b7212

	/// Nombre de banques du modèle (12)
	measure 'Nombre de banques' = COUNTROWS ( ALL ( Dim_Banque ) )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 4d950711-a56b-4a23-be7e-f54244785df7

	/// Nombre de banques qui ont un PNB du trimestre pour la sélection (toutes banques confondues, filtre de banque ignoré)
	measure 'Banques presentes PNB' = COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [PNB] ) ) )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: d015e47e-90fa-40ae-9aba-a34a7c3d2969

	/// Dernière date d'arrêté de la sélection où au moins une banque a un encours de crédits
	measure 'Date fin credits' =
			CALCULATE (
			    MAX ( Fait_Indicateurs[date_arrete] ),
			    REMOVEFILTERS ( Dim_Banque ),
			    Dim_Indicateur[code_indicateur] = "CREDITS",
			    NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
			)
		formatString: Short Date
		displayFolder: 2. Secteur\Intermédiaires
		lineageTag: f9987cb8-f7e9-42e0-95db-ad3b0aae8dcb

	/// Nombre de banques qui ont un encours de crédits à la dernière date de la sélection
	measure 'Banques presentes credits' =
			VAR DateFin = [Date fin credits]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Credits brut] ) ) ),
			        REMOVEFILTERS ( Dim_Date ),
			        Dim_Date[Date] = DateFin
			    )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 0ee13b6a-eaf9-40af-9310-ae80bb19cc0e

	/// Dernière date d'arrêté de la sélection où au moins une banque a un encours de dépôts
	measure 'Date fin depots' =
			CALCULATE (
			    MAX ( Fait_Indicateurs[date_arrete] ),
			    REMOVEFILTERS ( Dim_Banque ),
			    Dim_Indicateur[code_indicateur] = "DEPOTS",
			    NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
			)
		formatString: Short Date
		displayFolder: 2. Secteur\Intermédiaires
		lineageTag: 9fa8a5d8-52ea-4bfd-a41e-366a10b735c4

	/// Nombre de banques qui ont un encours de dépôts à la dernière date de la sélection
	measure 'Banques presentes depots' =
			VAR DateFin = [Date fin depots]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Depots brut] ) ) ),
			        REMOVEFILTERS ( Dim_Date ),
			        Dim_Date[Date] = DateFin
			    )
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 95e9668e-e389-4ef1-a189-7a7e3e08a969

	/// Nombre de banques qui ont une valeur (cumul ou solde) pour l'indicateur choisi à la date sélectionnée ; vide si aucun ou plusieurs indicateurs sont choisis
	measure 'Banques presentes' =
			IF (
			    HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
			    COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Valeur Cumul] ) ) )
			)
		formatString: 0
		displayFolder: 2. Secteur\Banques présentes
		lineageTag: 87eb6a28-4df8-4528-a306-f43e85b6ff69

	/// PNB du trimestre des 12 banques ; vide si une banque manque
	measure 'PNB secteur' =
			IF (
			    [Banques presentes PNB] = [Nombre de banques],
			    CALCULATE ( [PNB], REMOVEFILTERS ( Dim_Banque ) )
			)
		formatString: #,0.0
		displayFolder: 2. Secteur\Totaux
		lineageTag: e538ba6b-082d-44ad-819c-a548b1ac7162

	/// Encours de crédits des 12 banques à la dernière date de la sélection ; vide si une banque manque à cette date
	measure 'Credits secteur' =
			VAR DateFin = [Date fin credits]
			RETURN
			    IF (
			        [Banques presentes credits] = [Nombre de banques],
			        CALCULATE ( [Credits brut], REMOVEFILTERS ( Dim_Banque ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
			    )
		formatString: #,0.000
		displayFolder: 2. Secteur\Totaux
		lineageTag: 8548e2a0-5eb4-4c3d-b1eb-fa70dfe9d368

	/// Encours de dépôts des 12 banques à la dernière date de la sélection ; vide si une banque manque à cette date
	measure 'Depots secteur' =
			VAR DateFin = [Date fin depots]
			RETURN
			    IF (
			        [Banques presentes depots] = [Nombre de banques],
			        CALCULATE ( [Depots brut], REMOVEFILTERS ( Dim_Banque ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
			    )
		formatString: #,0.000
		displayFolder: 2. Secteur\Totaux
		lineageTag: 79b5301f-435b-4c51-8a53-01720e06ea80

	/// Part de la banque dans le PNB du trimestre des 12 banques
	measure 'Part de marche PNB' = DIVIDE ( [PNB], [PNB secteur] )
		formatString: 0.00 %
		displayFolder: 2. Secteur\Parts de marché
		lineageTag: 66e17236-908e-4f1f-9f5d-6083c83b74b9

	/// Part de la banque dans l'encours de crédits des 12 banques
	measure 'Part de marche credits' = DIVIDE ( [Credits], [Credits secteur] )
		formatString: 0.00 %
		displayFolder: 2. Secteur\Parts de marché
		lineageTag: f5e0e093-aa82-4782-a85e-3923ca6b0109

	/// Part de la banque dans l'encours de dépôts des 12 banques
	measure 'Part de marche depots' = DIVIDE ( [Depots], [Depots secteur] )
		formatString: 0.00 %
		displayFolder: 2. Secteur\Parts de marché
		lineageTag: 61e9d957-6a3a-48cb-af22-f667d5c26594

	/// Indice de Herfindahl-Hirschman du PNB : somme des carrés des parts de marché × 10 000 (de 833 si les 12 banques étaient égales à 10 000 pour une seule banque) ; vide si une banque manque
	measure 'HHI PNB' =
			IF (
			    NOT ISBLANK ( [PNB secteur] ),
			    SUMX ( ALL ( Dim_Banque ), [Part de marche PNB] ^ 2 ) * 10000
			)
		formatString: #,0
		displayFolder: 2. Secteur\Concentration
		lineageTag: 584dc97c-6650-463b-a79e-570ceb8a3bb3

	/// Rang de la banque par PNB du trimestre (1 = le plus élevé) ; vide hors d'une ligne de banque ou si une banque manque
	measure 'Rang PNB' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] ) && NOT ISBLANK ( [PNB] ) && NOT ISBLANK ( [PNB secteur] ),
			    RANKX ( ALL ( Dim_Banque ), [PNB], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: 2. Secteur\Rangs
		lineageTag: 76443ff9-961f-461a-9060-55231054c44d

	/// Dernier trimestre où les 12 banques ont publié PNB, crédits et dépôts (colonne Choix_Trimestre de Dim_Date), par exemple « 2026T3 »
	measure 'Dernier trimestre complet' =
			CALCULATE (
			    SELECTEDVALUE ( Dim_Date[Annee_Trimestre] ),
			    REMOVEFILTERS ( Dim_Date ),
			    Dim_Date[Choix_Trimestre] = "Dernier trimestre complet"
			)
		displayFolder: 2. Secteur\Dernier trimestre complet
		lineageTag: e1072f8e-30f4-4927-a267-2c879f6468ef

	/// Date d'arrêté du dernier trimestre complet
	measure 'Date dernier trimestre complet' =
			CALCULATE (
			    MAX ( Dim_Date[Date] ),
			    REMOVEFILTERS ( Dim_Date ),
			    Dim_Date[Choix_Trimestre] = "Dernier trimestre complet"
			)
		formatString: Short Date
		displayFolder: 2. Secteur\Dernier trimestre complet
		lineageTag: d7148d63-af80-4826-8fe9-4a917b45d5ba

	/// Coefficient publié = charges opératoires publiées / PNB du trimestre ; POUR INFORMATION (le contenu des charges opératoires varie d'une banque à l'autre : Definitions_Charges), jamais classé
	measure 'Coef exploitation publie' = DIVIDE ( [Charges operatoires], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Coefficient d'exploitation
		lineageTag: 32e55846-9677-4dbc-9c0c-46e30edc413f

	/// Coefficient harmonisé = (frais de personnel + charges générales) / PNB du trimestre, sur les banques qui publient les trois montants ; sert à toutes les comparaisons et classements
	measure 'Coef exploitation harmonise' =
			VAR Lignes =
			    ADDCOLUMNS (
			        VALUES ( Dim_Banque[code_banque] ),
			        "@Pers", [Frais personnel],
			        "@Gen", [Charges generales],
			        "@PNB", [PNB]
			    )
			VAR Completes =
			    FILTER ( Lignes, NOT ISBLANK ( [@Pers] ) && NOT ISBLANK ( [@Gen] ) && NOT ISBLANK ( [@PNB] ) )
			RETURN
			    DIVIDE ( SUMX ( Completes, [@Pers] + [@Gen] ), SUMX ( Completes, [@PNB] ) )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Coefficient d'exploitation
		lineageTag: 5972de1e-013f-452d-89dd-c3dd192cb679

	/// Frais de personnel de l'année : cumul publié au 31/12
	measure 'Frais personnel annuel' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "FRAIS_PERS", Dim_Date[Trimestre] = "T4" )
		formatString: #,0.000
		displayFolder: 3. Ratios\Intermédiaires
		lineageTag: e3621bf7-8ca9-441a-be6d-e66b503ef63f

	/// Charges générales d'exploitation de l'année : cumul publié au 31/12
	measure 'Charges generales annuel' = CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CHG_GEN", Dim_Date[Trimestre] = "T4" )
		formatString: #,0.000
		displayFolder: 3. Ratios\Intermédiaires
		lineageTag: 8e86718d-773e-4a67-8439-3f18d5d97e7e

	/// Coefficient harmonisé de l'année, à partir des cumuls publiés au 31/12 (jamais la somme des trimestres) ; vide pour une année sans T4 publié
	measure 'Coef exploitation harmonise annuel' =
			VAR Lignes =
			    ADDCOLUMNS (
			        VALUES ( Dim_Banque[code_banque] ),
			        "@Pers", [Frais personnel annuel],
			        "@Gen", [Charges generales annuel],
			        "@PNB", [PNB annuel]
			    )
			VAR Completes =
			    FILTER ( Lignes, NOT ISBLANK ( [@Pers] ) && NOT ISBLANK ( [@Gen] ) && NOT ISBLANK ( [@PNB] ) )
			RETURN
			    DIVIDE ( SUMX ( Completes, [@Pers] + [@Gen] ), SUMX ( Completes, [@PNB] ) )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Coefficient d'exploitation
		lineageTag: 4e9f9ab5-f5df-4f96-b5ed-2b36733a3a57

	/// Nombre de banques qui publient frais de personnel, charges générales et PNB pour le trimestre sélectionné
	measure 'Banques presentes coef' =
			COUNTROWS (
			    FILTER (
			        ALL ( Dim_Banque ),
			        NOT ISBLANK ( [Frais personnel] ) && NOT ISBLANK ( [Charges generales] ) && NOT ISBLANK ( [PNB] )
			    )
			)
		formatString: 0
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: 2a10b6a0-a3a7-44b2-97fa-29b5f8980f19

	/// Coefficient harmonisé du secteur (moyenne pondérée par le PNB : somme des charges / somme des PNB des 12 banques) ; vide si une banque manque
	measure 'Coef secteur' =
			IF (
			    [Banques presentes coef] = [Nombre de banques],
			    CALCULATE ( [Coef exploitation harmonise], REMOVEFILTERS ( Dim_Banque ) )
			)
		formatString: 0.0 %
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: e1129c7a-09ce-47e9-8e14-8037ea0e1d8e

	/// Médiane des coefficients harmonisés des 12 banques (banque « du milieu », insensible aux extrêmes) ; vide si une banque manque
	measure 'Coef mediane' =
			IF (
			    [Banques presentes coef] = [Nombre de banques],
			    MEDIANX ( ALL ( Dim_Banque ), [Coef exploitation harmonise] )
			)
		formatString: 0.0 %
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: 66d81358-c661-43e8-a333-25d00a3248e4

	/// Écart du coefficient harmonisé de la banque à la médiane (négatif = plus efficace que la banque médiane) ; vide hors d'une ligne de banque
	measure 'Ecart coef / mediane' =
			VAR Coef = [Coef exploitation harmonise]
			VAR Mediane = [Coef mediane]
			RETURN
			    IF (
			        HASONEVALUE ( Dim_Banque[code_banque] ) && NOT ISBLANK ( Coef ) && NOT ISBLANK ( Mediane ),
			        Coef - Mediane
			    )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: ddbc5e6f-ba4a-40c7-b1f7-a924f7558441

	/// Rang du coefficient harmonisé (1 = le plus bas, donc la banque la plus efficace) ; vide hors d'une ligne de banque ou si une banque manque
	measure 'Rang coef' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] )
			        && NOT ISBLANK ( [Coef exploitation harmonise] )
			        && [Banques presentes coef] = [Nombre de banques],
			    RANKX ( ALL ( Dim_Banque ), [Coef exploitation harmonise], , ASC, DENSE )
			)
		formatString: 0
		displayFolder: 3. Ratios\Comparaison au secteur
		lineageTag: aa68b87e-45c9-4e25-be43-0233f33c9c54

	/// Marge d'intérêts / PNB du trimestre
	measure 'Part marge interets' = DIVIDE ( [Marge interets], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: 11e8fe2e-9e02-4d3a-9f50-78bc6362a75a

	/// Marge sur commissions / PNB du trimestre
	measure 'Part commissions' = DIVIDE ( [Marge commissions], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: fadca509-b188-466e-a03e-66c8c87507e7

	/// Revenus du portefeuille-titres / PNB du trimestre
	measure 'Part portefeuille' = DIVIDE ( [Revenus portefeuille], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: a2c62407-cf52-4a79-a6c3-27f97640c418

	/// Frais de personnel / PNB du trimestre
	measure 'Frais personnel / PNB' = DIVIDE ( [Frais personnel], [PNB] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Structure du PNB
		lineageTag: 2f4cd4a1-36e9-4779-871b-72b1c2ca3d26

	/// Encours des crédits / encours des dépôts en fin de période (plus de 100 % : la banque prête plus qu'elle ne collecte de dépôts)
	measure 'Credits / Depots' = DIVIDE ( [Credits], [Depots] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Bilan
		lineageTag: 59af4594-1963-4699-81fe-9f1e69917edf

	/// Dépôts à vue / total des dépôts en fin de période (ressources peu coûteuses)
	measure 'Part depots a vue' = DIVIDE ( [Depots a vue], [Depots] )
		formatString: 0.0 %
		displayFolder: 3. Ratios\Bilan
		lineageTag: 19e949ba-3af9-42a9-8a24-00117e43994f

	/// Somme des valeurs N du trimestre seul (même document que N-1) ; vide si plusieurs dates d'arrêté
	measure 'VC N trim' =
			IF (
			    DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
			    CALCULATE ( SUM ( Variations_Comparables[valeur_N] ), Variations_Comparables[mesure] = "trim" )
			)
		formatString: #,0.000
		displayFolder: 4. Croissances\Intermédiaires
		lineageTag: c97562a6-42a1-4639-b8a9-07517c2c38be

	/// Somme des valeurs N-1 du trimestre seul, lues dans le document de l'année N
	measure 'VC N1 trim' =
			IF (
			    DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
			    CALCULATE ( SUM ( Variations_Comparables[valeur_N1] ), Variations_Comparables[mesure] = "trim" )
			)
		formatString: #,0.000
		displayFolder: 4. Croissances\Intermédiaires
		lineageTag: 18757622-cab1-4350-8918-da48188f9344

	/// Somme des valeurs N du cumul depuis janvier (flux) ou du solde (stock)
	measure 'VC N cumul' =
			IF (
			    DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
			    CALCULATE ( SUM ( Variations_Comparables[valeur_N] ), Variations_Comparables[mesure] = "cumul" )
			)
		formatString: #,0.000
		displayFolder: 4. Croissances\Intermédiaires
		lineageTag: e35a6d1c-5a5c-488f-91f9-a11bb031bcc0

	/// Somme des valeurs N-1 du cumul ou du solde, lues dans le document de l'année N
	measure 'VC N1 cumul' =
			IF (
			    DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
			    CALCULATE ( SUM ( Variations_Comparables[valeur_N1] ), Variations_Comparables[mesure] = "cumul" )
			)
		formatString: #,0.000
		displayFolder: 4. Croissances\Intermédiaires
		lineageTag: 501a532a-a5a6-4ff8-b5f7-56c320845b2e

	/// Variation sur un an du trimestre seul, pour l'indicateur choisi ; vide si une banque de la sélection n'a pas N et N-1
	measure 'Var A/A trimestre %' =
			IF (
			    HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
			    VAR Lignes =
			        ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@N", [VC N trim], "@N1", [VC N1 trim] )
			    VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@N] ) && NOT ISBLANK ( [@N1] ) )
			    VAR N = SUMX ( Completes, [@N] )
			    VAR N1 = SUMX ( Completes, [@N1] )
			    RETURN
			        IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), DIVIDE ( N - N1, ABS ( N1 ) ) )
			)
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: 1e00a540-ea22-4547-9787-0d840ba3c0ee

	/// Variation sur un an du cumul ou du solde à une date d'arrêté, pour l'indicateur choisi
	measure 'Var A/A cumul a la date %' =
			IF (
			    HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
			    VAR Lignes =
			        ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@N", [VC N cumul], "@N1", [VC N1 cumul] )
			    VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@N] ) && NOT ISBLANK ( [@N1] ) )
			    VAR N = SUMX ( Completes, [@N] )
			    VAR N1 = SUMX ( Completes, [@N1] )
			    RETURN
			        IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), DIVIDE ( N - N1, ABS ( N1 ) ) )
			)
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Intermédiaires
		lineageTag: 1480ea82-6e1d-42ce-8c28-759736275f4d

	/// Variation sur un an du cumul depuis janvier (flux) ou du solde (stock), à la dernière date de la sélection qui a une valeur
	measure 'Var A/A cumul %' =
			VAR DateFin =
			    CALCULATE ( MAX ( Variations_Comparables[date_arrete] ), Variations_Comparables[mesure] = "cumul" )
			RETURN
			    CALCULATE ( [Var A/A cumul a la date %], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: 029a9028-f51a-41a3-86e6-bf00a571c3c3

	/// PNB du trimestre seul : variation sur un an (même document)
	measure 'Var PNB A/A %' = CALCULATE ( [Var A/A trimestre %], Dim_Indicateur[code_indicateur] = "PNB" )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: b7473b83-77ad-447a-a684-d34efd753128

	/// PNB cumulé depuis janvier : variation sur un an (même document)
	measure 'Var PNB cumul A/A %' = CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "PNB" )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: fcb49998-be02-4419-89e0-be73e6cdd1c1

	/// PNB de l'année : variation sur un an du cumul au 31/12, dans le document du T4
	measure 'Var PNB annuel A/A %' = CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "PNB", Dim_Date[Trimestre] = "T4" )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: c141a249-bf2b-40fb-9a90-e389198f05a1

	/// Charges opératoires cumulées : variation sur un an (contenu propre à chaque banque, stable dans un même document)
	measure 'Var Charges operatoires A/A %' = CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "CHG_OPER" )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: c0287eeb-12bb-474b-89c4-adbb63dc7835

	/// Encours des crédits : variation sur un an
	measure 'Var Credits A/A %' = CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "CREDITS" )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: edd71f5a-fd76-49c6-86f1-899a722da3d7

	/// Encours des dépôts : variation sur un an
	measure 'Var Depots A/A %' = CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "DEPOTS" )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un an
		lineageTag: 2cb315b1-363f-4e19-beef-2d1c42aa08e9

	/// PNB du trimestre précédent (document du trimestre précédent : à lire avec les marqueurs de rupture)
	measure 'PNB T-1' = CALCULATE ( [PNB], DATEADD ( Dim_Date[Date], -1, QUARTER ) )
		formatString: #,0.000
		displayFolder: 4. Croissances\Sur un trimestre
		lineageTag: 4e0ae578-fd2d-4c19-be5d-79ff47b1c329

	/// PNB : variation par rapport au trimestre précédent (deux documents successifs, pas d'autre source) ; vide si une banque de la sélection manque à l'un des deux trimestres
	measure 'Var PNB T/T %' =
			VAR Lignes =
			    ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@P", [PNB], "@P1", [PNB T-1] )
			VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@P] ) && NOT ISBLANK ( [@P1] ) )
			VAR P = SUMX ( Completes, [@P] )
			VAR P1 = SUMX ( Completes, [@P1] )
			RETURN
			    IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), DIVIDE ( P - P1, ABS ( P1 ) ) )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur un trimestre
		lineageTag: 9415267d-be3a-4649-8f43-b434fc5e3430

	/// PNB des 4 derniers trimestres publiés jusqu'à la dernière date de la sélection : indicateur de TENDANCE (somme de trimestres), jamais un chiffre annuel ; vide s'il manque un trimestre ou une banque de la sélection
	measure 'PNB 4T glissants' =
			VAR Fin = CALCULATE ( MAX ( Fait_Indicateurs[date_arrete] ), Dim_Indicateur[code_indicateur] = "PNB" )
			VAR NbBanques = COUNTROWS ( VALUES ( Dim_Banque[code_banque] ) )
			VAR Trimestres =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( Dim_Date[Cle_Trimestre] ),
			            "@PNB", [PNB],
			            "@Banques", COUNTROWS ( FILTER ( VALUES ( Dim_Banque[code_banque] ), NOT ISBLANK ( [PNB] ) ) )
			        ),
			        REMOVEFILTERS ( Dim_Date ),
			        Dim_Date[Date] > EDATE ( Fin, -12 ),
			        Dim_Date[Date] <= Fin
			    )
			VAR Complets = FILTER ( Trimestres, [@Banques] = NbBanques )
			RETURN
			    IF ( NOT ISBLANK ( Fin ) && COUNTROWS ( Complets ) = 4, SUMX ( Complets, [@PNB] ) )
		formatString: #,0.000
		displayFolder: 4. Croissances\Tendance
		lineageTag: cfe612a6-054f-463b-840e-d8922c1b1c73

	/// Croissance annuelle moyenne du PNB de 2020 à 2025 : enchaînement des 5 variations annuelles comparables (2021 à 2025, chacune dans son document T4), jamais 2025 / 2020 entre deux documents ; vide s'il en manque une
	measure 'TCAM PNB 2020-2025' =
			VAR Annees = GENERATESERIES ( 2021, 2025 )
			VAR Variations =
			    ADDCOLUMNS (
			        Annees,
			        "@Var",
			            VAR A = [Value]
			            RETURN
			                CALCULATE ( [Var PNB annuel A/A %], REMOVEFILTERS ( Dim_Date ), Dim_Date[Annee] = A )
			    )
			VAR Completes = COUNTROWS ( FILTER ( Variations, NOT ISBLANK ( [@Var] ) ) )
			RETURN
			    IF ( Completes = 5, PRODUCTX ( Variations, 1 + [@Var] ) ^ ( 1 / 5 ) - 1 )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Croissances\Sur plusieurs années
		lineageTag: d56c154d-f076-4d84-ace9-84ab753f20b2

	/// Description des événements (evenements.csv) de la banque, de l'indicateur et de la date du point ; un par ligne
	measure 'Evenement texte' = CONCATENATEX ( VALUES ( Evenements[description] ), Evenements[description], UNICHAR ( 10 ) )
		displayFolder: 4. Croissances\Annotations
		lineageTag: bb035b09-0210-45c5-be0b-ee99033b8083

	/// Montant cité par les événements du point (MDT)
	measure 'Evenement montant MDT' = SUM ( Evenements[montant_mdt] )
		formatString: #,0.000
		displayFolder: 4. Croissances\Annotations
		lineageTag: b455b2e6-0385-4a2a-8f9d-fab378fcde71

	/// Nombre d'événements du point
	measure 'Nb evenements' = COUNTROWS ( Evenements )
		formatString: 0
		displayFolder: 4. Croissances\Annotations
		lineageTag: 75abeffe-dd63-44d5-8aa4-bd48adfb94ae

	/// Marqueur de rupture de série : PNB du trimestre là où la période a été révisée de plus de 2 % sur le cumul (série de points à superposer à la courbe)
	measure 'Rupture PNB' =
			IF (
			    CALCULATE (
			        COUNTROWS ( Fait_Indicateurs ),
			        Fait_Indicateurs[Rupture_Trim] = "oui",
			        Dim_Indicateur[code_indicateur] = "PNB"
			    ) > 0,
			    [PNB]
			)
		formatString: #,0.000
		displayFolder: 4. Croissances\Annotations
		lineageTag: 9776692c-dccc-4193-affe-2684d013f023

	/// Marqueur de rupture de série sur le PNB cumulé depuis janvier
	measure 'Rupture PNB cumul' =
			IF (
			    CALCULATE (
			        COUNTROWS ( Fait_Indicateurs ),
			        Fait_Indicateurs[Rupture_Cumul] = "oui",
			        Dim_Indicateur[code_indicateur] = "PNB"
			    ) > 0,
			    [PNB depuis debut annee]
			)
		formatString: #,0.000
		displayFolder: 4. Croissances\Annotations
		lineageTag: fdb32c05-17f0-4e5e-b742-92a029821b9d

	/// Somme des valeurs retenues des états financiers ; vide si plusieurs dates d'arrêté
	measure 'EF valeur' = IF ( DISTINCTCOUNT ( Fait_Etats_Financiers[date_arrete] ) = 1, SUM ( Fait_Etats_Financiers[valeur_mdt] ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: adf1c5e9-7a6b-482a-af2e-d6e5f3cbf572

	/// Résultat net (avant modifications comptables) à une date d'arrêté, cumulé depuis le 1er janvier
	measure 'Resultat net brut' = CALCULATE ( [EF valeur], Dim_Indicateur[code_indicateur] = "RES_NET" )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: 376e3c18-e7f3-4c41-b4cb-8367e7473edb

	/// Capitaux propres du bilan (résultat inclus) à une date d'arrêté
	measure 'Cap propres EF brut' = CALCULATE ( [EF valeur], Dim_Indicateur[code_indicateur] = "CAP_PROPRES_EF" )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: 13f91ce4-94d7-4288-a81c-1fa703f8a376

	/// Total de l'actif du bilan à une date d'arrêté
	measure 'Total actif brut' = CALCULATE ( [EF valeur], Dim_Indicateur[code_indicateur] = "TOTAL_ACTIF" )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: f805b359-a8e3-4e5b-9564-615bf8d84a0f

	/// Résultat net annualisé à une date d'arrêté : × facteur_annualisation (2 au 30/06, 1 au 31/12)
	measure 'Resultat net annualise brut' =
			CALCULATE (
			    IF (
			        DISTINCTCOUNT ( Fait_Etats_Financiers[date_arrete] ) = 1,
			        SUMX ( Fait_Etats_Financiers, Fait_Etats_Financiers[valeur_mdt] * Fait_Etats_Financiers[facteur_annualisation] )
			    ),
			    Dim_Indicateur[code_indicateur] = "RES_NET"
			)
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: e2948901-4b15-427d-8dca-7e26e92b72a3

	/// Dernière date d'arrêté des états financiers (30/06 ou 31/12) de la sélection qui a un résultat net
	measure 'Date fin EF' = CALCULATE ( MAX ( Fait_Etats_Financiers[date_arrete] ), Dim_Indicateur[code_indicateur] = "RES_NET" )
		formatString: Short Date
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: 7a836b19-4c16-4803-966b-1758b278c94f

	/// Résultat net publié (avant modifications comptables), cumulé depuis le 1er janvier, à la dernière date de la sélection
	measure 'Resultat net' = CALCULATE ( [Resultat net brut], LASTNONBLANK ( Dim_Date[Date], [Resultat net brut] ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: 60767345-faf6-4137-a174-e88ddb4ec7d7

	/// Capitaux propres du bilan (résultat inclus) à la dernière date de la sélection : référence de toutes les comparaisons entre banques
	measure 'Cap propres EF' = CALCULATE ( [Cap propres EF brut], LASTNONBLANK ( Dim_Date[Date], [Cap propres EF brut] ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: 473fd50e-d51b-4f94-b5df-fb0fcad3b190

	/// Total de l'actif du bilan à la dernière date de la sélection
	measure 'Total actif' = CALCULATE ( [Total actif brut], LASTNONBLANK ( Dim_Date[Date], [Total actif brut] ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: 443337c0-7cca-4f8b-92b0-a914753b247e

	/// Résultat net annualisé à une date d'arrêté, banque par banque ; vide si une banque de la sélection manque
	measure 'Resultat net annualise a la date' =
			VAR Lignes = ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@RN", [Resultat net annualise brut] )
			VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@RN] ) )
			RETURN
			    IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), SUMX ( Completes, [@RN] ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: 33a79d19-be32-4c80-ac94-9c107cb53a51

	/// Capitaux propres moyens à une date d'arrêté : (31/12/N-1 + date) / 2, banque par banque ; vide si l'une des deux valeurs manque (jamais une seule valeur prise pour la moyenne)
	measure 'Cap propres moyens a la date' =
			VAR Ouverture = DATE ( YEAR ( MAX ( Dim_Date[Date] ) ) - 1, 12, 31 )
			VAR Lignes =
			    ADDCOLUMNS (
			        VALUES ( Dim_Banque[code_banque] ),
			        "@Fin", [Cap propres EF brut],
			        "@Ouv", CALCULATE ( [Cap propres EF brut], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = Ouverture )
			    )
			VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@Fin] ) && NOT ISBLANK ( [@Ouv] ) )
			RETURN
			    IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), SUMX ( Completes, ( [@Ouv] + [@Fin] ) / 2 ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: d440fc03-aed5-46df-94c4-8e726a765318

	/// Total de l'actif moyen à une date d'arrêté : (31/12/N-1 + date) / 2, banque par banque ; vide si l'une des deux valeurs manque
	measure 'Total actif moyen a la date' =
			VAR Ouverture = DATE ( YEAR ( MAX ( Dim_Date[Date] ) ) - 1, 12, 31 )
			VAR Lignes =
			    ADDCOLUMNS (
			        VALUES ( Dim_Banque[code_banque] ),
			        "@Fin", [Total actif brut],
			        "@Ouv", CALCULATE ( [Total actif brut], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = Ouverture )
			    )
			VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@Fin] ) && NOT ISBLANK ( [@Ouv] ) )
			RETURN
			    IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), SUMX ( Completes, ( [@Ouv] + [@Fin] ) / 2 ) )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Intermédiaires
		lineageTag: 2edc98ae-d122-4408-83e0-a0a23c60ca13

	/// Résultat net annualisé à la dernière date des états financiers de la sélection (× 2 pour un semestre)
	measure 'Resultat net annualise' =
			VAR DateFin = [Date fin EF]
			RETURN
			    CALCULATE ( [Resultat net annualise a la date], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: cdb2341f-27ef-4a6f-92cc-34dd32ffa349

	/// Capitaux propres moyens du bilan à la dernière date des états financiers de la sélection
	measure 'Cap propres moyens' =
			VAR DateFin = [Date fin EF]
			RETURN
			    CALCULATE ( [Cap propres moyens a la date], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: 691af1f9-0b90-41ba-8f40-697cbd6d3cd4

	/// Total de l'actif moyen à la dernière date des états financiers de la sélection
	measure 'Total actif moyen' =
			VAR DateFin = [Date fin EF]
			RETURN
			    CALCULATE ( [Total actif moyen a la date], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
		formatString: #,0.000
		displayFolder: 5. Rentabilité\Bilan et résultat
		lineageTag: 0a24b836-358f-452e-af3a-80a779839b24

	/// ROE = résultat net annualisé / capitaux propres moyens du bilan, à la dernière date des états financiers de la sélection (semestre annualisé au 30/06, exercice au 31/12) ; résultat semestriel non audité (revue limitée)
	measure ROE = DIVIDE ( [Resultat net annualise], [Cap propres moyens] )
		formatString: 0.0 %
		displayFolder: 5. Rentabilité\Ratios
		lineageTag: 4c185d61-035a-43e4-8647-468d072eab30

	/// ROA = résultat net annualisé / total de l'actif moyen, à la dernière date des états financiers de la sélection
	measure ROA = DIVIDE ( [Resultat net annualise], [Total actif moyen] )
		formatString: 0.00 %
		displayFolder: 5. Rentabilité\Ratios
		lineageTag: 78d9b965-d513-4b2d-84cb-09d94d875ae3

	/// ROE des 12 banques ensemble (somme des résultats / somme des capitaux propres moyens) ; vide si une banque manque
	measure 'ROE secteur' = CALCULATE ( [ROE], REMOVEFILTERS ( Dim_Banque ) )
		formatString: 0.0 %
		displayFolder: 5. Rentabilité\Ratios
		lineageTag: a4a6d1ac-1944-4aac-868b-02af2ef4d6fb

	/// ROA des 12 banques ensemble ; vide si une banque manque
	measure 'ROA secteur' = CALCULATE ( [ROA], REMOVEFILTERS ( Dim_Banque ) )
		formatString: 0.00 %
		displayFolder: 5. Rentabilité\Ratios
		lineageTag: 762e469d-f4d5-4627-9b5d-c4845045e238

	/// Clôture publiée d'une séance, pour une banque ; vide si plusieurs banques ou plusieurs séances
	measure 'Cloture brut' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] ) && DISTINCTCOUNT ( Fait_Cours[date] ) = 1,
			    SUM ( Fait_Cours[cloture] )
			)
		formatString: #,0.000
		displayFolder: 6. Bourse\Intermédiaires
		lineageTag: 88265629-66d3-4466-a7e4-a622b4cd3ea6

	/// Clôture ajustée des opérations sur le capital (attributions, divisions, souscriptions) d'une séance, pour une banque
	measure 'Cloture ajustee prix brut' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] ) && DISTINCTCOUNT ( Fait_Cours[date] ) = 1,
			    SUM ( Fait_Cours[cloture_ajustee_prix] )
			)
		formatString: #,0.000
		displayFolder: 6. Bourse\Intermédiaires
		lineageTag: 7f3a503e-a87e-4df3-b84c-af68b8a6b431

	/// Clôture ajustée de toutes les opérations, dividendes compris, d'une séance, pour une banque
	measure 'Cloture ajustee rendement brut' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] ) && DISTINCTCOUNT ( Fait_Cours[date] ) = 1,
			    SUM ( Fait_Cours[cloture_ajustee_rendement] )
			)
		formatString: #,0.000
		displayFolder: 6. Bourse\Intermédiaires
		lineageTag: c8418bdb-2609-45f5-9bc4-c646ab795e01

	/// Dernière clôture publiée de la période (DT), pour une banque
	measure 'Dernier cours' = CALCULATE ( [Cloture brut], LASTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )
		formatString: #,0.000
		displayFolder: 6. Bourse\Cours
		lineageTag: c65de410-d2e0-4266-b467-d8d787bbafaa

	/// Première clôture publiée de la période (DT), pour une banque
	measure 'Premier cours' = CALCULATE ( [Cloture brut], FIRSTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )
		formatString: #,0.000
		displayFolder: 6. Bourse\Cours
		lineageTag: 0c0ac398-f646-45b5-9696-524a57c3e6af

	/// Date de la dernière clôture publiée de la période
	measure 'Date dernier cours' = CALCULATE ( MAX ( Dim_Date[Date] ), LASTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )
		formatString: Short Date
		displayFolder: 6. Bourse\Cours
		lineageTag: eda7d2fb-5763-4444-a262-cae7684a3390

	/// Date de la première clôture publiée de la période
	measure 'Date premier cours' = CALCULATE ( MIN ( Dim_Date[Date] ), FIRSTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )
		formatString: Short Date
		displayFolder: 6. Bourse\Cours
		lineageTag: d19f8658-ced7-4855-aaeb-1da958d65ebf

	/// Performance du prix sur la période : dernière / première clôture ajustée des opérations sur le capital, − 1 (hors dividendes)
	measure 'Performance prix' =
			VAR Debut = CALCULATE ( [Cloture ajustee prix brut], FIRSTNONBLANK ( Dim_Date[Date], [Cloture ajustee prix brut] ) )
			VAR Fin = CALCULATE ( [Cloture ajustee prix brut], LASTNONBLANK ( Dim_Date[Date], [Cloture ajustee prix brut] ) )
			RETURN
			    IF ( NOT ISBLANK ( Debut ) && NOT ISBLANK ( Fin ), DIVIDE ( Fin, Debut ) - 1 )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 6. Bourse\Performance
		lineageTag: aeade449-8c1e-49a0-96ec-4eb494de4310

	/// Rendement total sur la période, dividendes réinvestis : dernière / première clôture ajustée de toutes les opérations, − 1
	measure 'Rendement total' =
			VAR Debut = CALCULATE ( [Cloture ajustee rendement brut], FIRSTNONBLANK ( Dim_Date[Date], [Cloture ajustee rendement brut] ) )
			VAR Fin = CALCULATE ( [Cloture ajustee rendement brut], LASTNONBLANK ( Dim_Date[Date], [Cloture ajustee rendement brut] ) )
			RETURN
			    IF ( NOT ISBLANK ( Debut ) && NOT ISBLANK ( Fin ), DIVIDE ( Fin, Debut ) - 1 )
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 6. Bourse\Performance
		lineageTag: c18728bd-c00d-43c3-b00a-a54e7df18f56

	/// Volatilité annualisée : écart-type des rendements quotidiens (série rendement total) × racine de 252 séances, pour une banque ; vide sous 20 rendements ; à lire avec l'avertissement de liquidité
	measure 'Volatilite annualisee' =
			VAR Rendements = FILTER ( Fait_Cours, NOT ISBLANK ( Fait_Cours[rendement] ) )
			RETURN
			    IF (
			        HASONEVALUE ( Dim_Banque[code_banque] ) && COUNTROWS ( Rendements ) >= 20,
			        STDEVX.S ( Rendements, Fait_Cours[rendement] ) * SQRT ( 252 )
			    )
		formatString: 0.0 %
		displayFolder: 6. Bourse\Risque et liquidité
		lineageTag: 46802d22-ce3d-48fd-88f0-9842825ad94a

	/// Nombre de séances de la période
	measure Seances = COUNTROWS ( Fait_Cours )
		formatString: #,0
		displayFolder: 6. Bourse\Risque et liquidité
		lineageTag: 4c1067a2-011d-42b2-8e23-364e52e03454

	/// Nombre de séances sans transaction (aucun titre échangé ; la clôture est alors le cours de référence)
	measure 'Seances sans transaction' = CALCULATE ( [Seances], Fait_Cours[sans_transaction] = TRUE () )
		formatString: #,0
		displayFolder: 6. Bourse\Risque et liquidité
		lineageTag: 620a56b2-b115-4baa-bbb9-8829061da6ab

	/// Part des séances sans transaction dans la période
	measure 'Taux seances sans transaction' = DIVIDE ( [Seances sans transaction], [Seances] )
		formatString: 0.0 %
		displayFolder: 6. Bourse\Risque et liquidité
		lineageTag: 651f22d3-5cbd-4035-8246-78b8b99390ed

	/// Seuil au-delà duquel un titre est dit peu liquide (20 % des séances sans transaction)
	measure 'Seuil titre peu liquide' = 0.20
		formatString: 0 %
		displayFolder: 6. Bourse\Risque et liquidité
		lineageTag: 9ce65e5a-628c-454c-9d3f-55d0782283b8

	/// Avertissement affiché pour un titre peu liquide (une banque) : sa volatilité et sa performance reposent sur peu d'échanges
	measure 'Avertissement liquidite' =
			IF (
			    HASONEVALUE ( Dim_Banque[code_banque] ) && [Taux seances sans transaction] > [Seuil titre peu liquide],
			    "Titre peu liquide : " & FORMAT ( [Taux seances sans transaction], "0 %" )
			        & " des séances sans transaction ; volatilité et performance à lire avec prudence"
			)
		displayFolder: 6. Bourse\Risque et liquidité
		lineageTag: dbf21edb-d5ef-4ce5-b57b-31978fd89de0

	/// Date d'arrêté la plus récente des indicateurs trimestriels, tous filtres ignorés
	measure 'Date derniere donnee' = CALCULATE ( MAX ( Fait_Indicateurs[date_arrete] ), REMOVEFILTERS () )
		formatString: Short Date
		displayFolder: 7. Qualité\Affichage
		lineageTag: 14241acc-5bbf-4897-b6de-be0e768c54db

	/// Titre du rapport avec la date des dernières données
	measure 'Titre rapport' = "Banques cotées — données au " & FORMAT ( [Date derniere donnee], "dd/mm/yyyy" )
		displayFolder: 7. Qualité\Affichage
		lineageTag: 2aae83df-4d49-440c-ad2e-6022aff1abe6

	/// Couleur de mise en forme du coefficient : vert si la banque est plus efficace que la médiane (écart ≤ 0), rouge sinon ; rien si l'écart est vide
	measure 'Couleur coef' =
			VAR Ecart = [Ecart coef / mediane]
			RETURN
			    IF ( NOT ISBLANK ( Ecart ), IF ( Ecart <= 0, "#2E7D32", "#C62828" ) )
		displayFolder: 7. Qualité\Affichage
		lineageTag: 48cd0dd6-6ab0-4f8f-b284-101649baa59a

	/// Nombre de documents trimestriels (un par banque et par trimestre)
	measure 'Nb documents' = COUNTROWS ( Controle )
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: 3220dd64-93fd-46da-aa12-929bc7d08739

	/// Part des documents lus sans aucune alerte ; les autres ont surtout des écarts qui viennent des révisions des banques (Nb ecarts signales), pas d'erreurs d'extraction
	measure 'Part documents sans alerte' = DIVIDE ( CALCULATE ( [Nb documents], Controle[statut] = "ok" ), [Nb documents] )
		formatString: 0.0 %
		displayFolder: 7. Qualité\Documents
		lineageTag: 9373a03f-1d29-449b-a75a-31fb8e19edfa

	/// Documents avec un écart signalé qui vient de la banque (retraitement possible, écart trimestre/cumul, écart composantes), non bloquant
	measure 'Nb ecarts signales' =
			CALCULATE (
			    [Nb documents],
			    Controle[statut] IN { "retraitement possible", "ecart trimestre/cumul", "ecart composantes" }
			)
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: 79fd214a-e99f-4720-9604-961a8987b714

	/// Documents dont le trimestre seul ne vaut pas le cumul moins le cumul précédent (révision de la banque en cours d'année)
	measure 'Nb ecarts trim cumul' = CALCULATE ( [Nb documents], Controle[statut] = "ecart trimestre/cumul" )
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: 8850fd28-9a04-4cbd-b6d1-f08413a3e904

	/// Documents dont le total publié ne vaut pas la somme de ses composantes (incohérence de la banque, vérifiée dans le PDF)
	measure 'Nb ecarts composantes' = CALCULATE ( [Nb documents], Controle[statut] = "ecart composantes" )
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: b489693c-3589-44b9-b41c-dc81e96b338a

	/// Documents avec une alerte bloquante (erreur du document de la banque, vérifiée sur l'image)
	measure 'Nb documents a verifier' = CALCULATE ( [Nb documents], Controle[statut] = "a verifier" )
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: 12b20416-49b0-4776-869a-1a9fd39b01fd

	/// Documents publiés en image, repris du document suivant
	measure 'Nb documents illisibles' = CALCULATE ( [Nb documents], Controle[statut] = "illisible (image)" )
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: 6905ab98-f61b-4c6e-95ec-8703511bbba3

	/// Documents publiés en image, saisis à la main (saisies_manuelles.csv, contrôles de cohérence)
	measure 'Nb documents saisis' = CALCULATE ( [Nb documents], Controle[statut] = "saisie manuelle" )
		formatString: #,0
		displayFolder: 7. Qualité\Documents
		lineageTag: de708e53-9bea-4580-94a8-ed546204e6b7

	/// Part des cumuls affichés qui viennent d'une version révisée (colonne N-1 ou 31/12 d'un document suivant)
	measure 'Part cumuls revises' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Fait_Indicateurs ), LEFT ( Fait_Indicateurs[Source_Cumul], 7 ) = "revisee" ),
			    CALCULATE ( COUNTROWS ( Fait_Indicateurs ), NOT ISBLANK ( Fait_Indicateurs[Source_Cumul] ) )
			)
		formatString: 0.0 %
		displayFolder: 7. Qualité\Révisions
		lineageTag: f67f8be5-dc0b-4fcf-b489-939549592dd0

	/// Part des cumuls affichés qui viennent de la colonne 31/12 d'un document T1 à T3 suivant (le T4 de l'année suivante n'est pas encore publié)
	measure 'Part 31-12 provisoires' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Fait_Indicateurs ), LEFT ( Fait_Indicateurs[Source_Cumul], 14 ) = "revisee_31-12_" ),
			    CALCULATE ( COUNTROWS ( Fait_Indicateurs ), NOT ISBLANK ( Fait_Indicateurs[Source_Cumul] ) )
			)
		formatString: 0.0 %
		displayFolder: 7. Qualité\Révisions
		lineageTag: 4a741c2c-3974-4800-a142-c2cf1e9c3365

	/// Versions non retenues qui diffèrent de la valeur retenue de plus de 2 kDT
	measure 'Nb revisions' = CALCULATE ( COUNTROWS ( Revisions ), ABS ( Revisions[Ecart_MDT] ) > 0.002 )
		formatString: #,0
		displayFolder: 7. Qualité\Révisions
		lineageTag: 40b3a4bc-7d8b-431e-adfd-d1f166150330

	/// Valeurs initiales remplacées par une révision de plus de 2 % (sur le cumul)
	measure 'Nb revisions importantes' =
			CALCULATE (
			    COUNTROWS ( Revisions ),
			    Revisions[version] = "initiale",
			    Revisions[statut_revision] = "revision_importante"
			)
		formatString: #,0
		displayFolder: 7. Qualité\Révisions
		lineageTag: 956e492e-caba-4d0b-8020-f234515b0778

	/// Valeurs initiales remplacées par une révision de 2 % au plus
	measure 'Nb retraitements mineurs' =
			CALCULATE (
			    COUNTROWS ( Revisions ),
			    Revisions[version] = "initiale",
			    Revisions[statut_revision] = "retraitement_mineur"
			)
		formatString: #,0
		displayFolder: 7. Qualité\Révisions
		lineageTag: c68750c1-0d4f-4deb-8d70-51246cbc20df

	/// Versions où une composante change sans que le total change (reclassement)
	measure 'Nb reclassements' = CALCULATE ( COUNTROWS ( Revisions ), Revisions[statut_revision] = "reclassement" )
		formatString: #,0
		displayFolder: 7. Qualité\Révisions
		lineageTag: d354d4e1-c575-4ab3-8a82-8b0f271014f2

	/// Somme des écarts valeur retenue − version non retenue (MDT)
	measure 'Ecart revision MDT' = SUM ( Revisions[Ecart_MDT] )
		formatString: #,0.000
		displayFolder: 7. Qualité\Révisions
		lineageTag: c1d77067-d4d6-4bde-99a4-f8eaa193f8e1

	/// Indicateurs × trimestres en rupture de série (période révisée de plus de 2 % sur le cumul)
	measure 'Nb ruptures serie' =
			CALCULATE (
			    COUNTROWS ( Fait_Indicateurs ),
			    Fait_Indicateurs[Rupture_Trim] = "oui" || Fait_Indicateurs[Rupture_Cumul] = "oui"
			)
		formatString: #,0
		displayFolder: 7. Qualité\Révisions
		lineageTag: 632088b1-683b-4a50-bc48-daca26af6c8e

	/// Valeurs absentes parce que le document est en image et non repris (aucune depuis la saisie des documents BTE)
	measure 'Nb valeurs non disponibles' = CALCULATE ( COUNTROWS ( Revisions ), Revisions[statut_revision] = "non disponible (image)" )
		formatString: #,0
		displayFolder: 7. Qualité\Révisions
		lineageTag: e7339aa9-f14e-415c-82d7-7a89e59d2549

	/// Années × indicateurs dont la somme des 4 trimestres vaut le cumul annuel
	measure 'Nb annees conformes' = CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "ok" )
		formatString: #,0
		displayFolder: 7. Qualité\Contrôle annuel
		lineageTag: 40b3f7af-755a-49de-b30c-f41015da1d2b

	/// Années en attente du document de l'année suivante (versions révisées pas encore toutes publiées)
	measure 'Nb annees en attente' = CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "en attente de révision" )
		formatString: #,0
		displayFolder: 7. Qualité\Contrôle annuel
		lineageTag: ee5703d7-6333-487b-adfa-7b11aa78f0af

	/// Années × indicateurs avec un écart entre somme des trimestres et cumul annuel
	measure 'Nb ecarts annuels' = CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "ecart" )
		formatString: #,0
		displayFolder: 7. Qualité\Contrôle annuel
		lineageTag: 738437d2-a19b-447d-ac9c-0723c01dc2e2

	/// Écarts annuels dont la cause est écrite (docs/ecarts_annuels.csv : retraitement, erreur du document, reclassement, arrondi)
	measure 'Nb ecarts expliques' =
			CALCULATE (
			    COUNTROWS ( Controle_Annuel ),
			    Controle_Annuel[statut] = "ecart",
			    NOT ISBLANK ( Controle_Annuel[categorie_ecart] )
			)
		formatString: #,0
		displayFolder: 7. Qualité\Contrôle annuel
		lineageTag: a36d68cd-9730-444f-8f41-5e953be3cff8

	/// Années × indicateurs avec un changement de méthode en cours d'année (rupture de série)
	measure 'Nb ruptures annuelles' = CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "rupture de série" )
		formatString: #,0
		displayFolder: 7. Qualité\Contrôle annuel
		lineageTag: 30e43ba1-39e6-4c44-b72f-120dd17cf62a

	/// Somme des écarts annuels (somme des trimestres − cumul annuel, MDT)
	measure 'Ecart annuel MDT' = CALCULATE ( SUM ( Controle_Annuel[Ecart_MDT] ), Controle_Annuel[statut] = "ecart" )
		formatString: #,0.000
		displayFolder: 7. Qualité\Contrôle annuel
		lineageTag: 330aa5f1-595f-4711-b165-fc4e3b397283

	/// Valeurs des états financiers remplacées par une révision de plus de 2 %
	measure 'Nb revisions importantes EF' = CALCULATE ( COUNTROWS ( Revisions_Etats_Financiers ), Revisions_Etats_Financiers[statut_revision] = "revision_importante" )
		formatString: #,0
		displayFolder: 7. Qualité\États financiers
		lineageTag: 8f28f0c7-4f3c-4032-a209-c77706bd9f1b

	/// Les 3 banques au plus fort PNB du trimestre, de la première à la troisième (TOPN) ; vide si une banque manque
	measure 'Top 3 banques PNB' =
			IF (
			    NOT ISBLANK ( [PNB secteur] ),
			    CONCATENATEX ( TOPN ( 3, ALL ( Dim_Banque ), [PNB], DESC ), Dim_Banque[code_banque], ", ", [PNB], DESC )
			)
		displayFolder: 2. Secteur\Concentration
		lineageTag: 535bb36b-147b-4199-b994-b85a6770c8b6

	/// Part des 3 premières banques dans le PNB du trimestre (ratio de concentration CR3, à lire avec le HHI) ; vide si une banque manque
	measure 'Part 3 premieres banques PNB' =
			IF (
			    NOT ISBLANK ( [PNB secteur] ),
			    DIVIDE ( SUMX ( TOPN ( 3, ALL ( Dim_Banque ), [PNB], DESC ), [PNB] ), [PNB secteur] )
			)
		formatString: 0.0 %
		displayFolder: 2. Secteur\Concentration
		lineageTag: efd3c772-a5ff-486d-b2e3-e3c00918d572

	/// Nombre de changements d'actionnaire de référence dont la date d'effet est dans la période (relation inactive Banques_Actionnariat[date_debut] → Dim_Date, activée par USERELATIONSHIP ; les premières périodes, sans date de début, ne comptent pas)
	measure 'Changements actionnaire' =
			CALCULATE (
			    COUNTROWS ( Banques_Actionnariat ),
			    USERELATIONSHIP ( Banques_Actionnariat[date_debut], Dim_Date[Date] ),
			    NOT ISBLANK ( Banques_Actionnariat[date_debut] )
			)
		formatString: 0
		displayFolder: 2. Secteur\Actionnariat
		lineageTag: cc14e935-965f-4cde-b73b-c5399df3130d

	/// Changements d'actionnaire de référence de la période : banque, nouvel actionnaire et date d'effet
	measure 'Changements actionnaire detail' =
			CALCULATE (
			    CONCATENATEX (
			        Banques_Actionnariat,
			        Banques_Actionnariat[code_banque] & " : " & Banques_Actionnariat[actionnaire_reference]
			            & " (" & FORMAT ( Banques_Actionnariat[date_debut], "dd/mm/yyyy" ) & ")",
			        UNICHAR ( 10 ),
			        Banques_Actionnariat[date_debut], ASC
			    ),
			    USERELATIONSHIP ( Banques_Actionnariat[date_debut], Dim_Date[Date] ),
			    NOT ISBLANK ( Banques_Actionnariat[date_debut] )
			)
		displayFolder: 2. Secteur\Actionnariat
		lineageTag: 6ea7d102-b067-43c5-8767-d328da488f95

	/// Nombre de faits marquants (événements, écarts annuels expliqués, révisions importantes des états financiers) de la sélection
	measure 'Nb faits marquants' = COUNTROWS ( Journal_Faits_Marquants )
		formatString: #,0
		displayFolder: 7. Qualité\Journal
		lineageTag: 6ed73c23-678a-40ee-9a3a-6fea7efed5c3

	/// PNB du trimestre des 12 banques, mis en forme pour une carte (« 1 936,6 »)
	measure 'PNB secteur texte' =
			VAR Valeur = [PNB secteur]
			RETURN
			    IF ( NOT ISBLANK ( Valeur ), FORMAT ( Valeur, "#,0.0" ) )
		displayFolder: 2. Secteur\Affichage
		lineageTag: 106e61ce-116e-4885-906d-10a500b3acb7

	/// Encours de crédits des 12 banques, mis en forme pour une carte (« 86 880 »)
	measure 'Credits secteur texte' =
			VAR Valeur = [Credits secteur]
			RETURN
			    IF ( NOT ISBLANK ( Valeur ), FORMAT ( Valeur, "#,0" ) )
		displayFolder: 2. Secteur\Affichage
		lineageTag: 86768bb0-e42b-4e35-9032-b35f0a3e04b2

	/// Encours de dépôts des 12 banques, mis en forme pour une carte (« 112 896 »)
	measure 'Depots secteur texte' =
			VAR Valeur = [Depots secteur]
			RETURN
			    IF ( NOT ISBLANK ( Valeur ), FORMAT ( Valeur, "#,0" ) )
		displayFolder: 2. Secteur\Affichage
		lineageTag: 4ef9016e-5330-4ed8-9f35-1f48bb7b5bc1

	/// Trimestre filtré par la barre de lecture (Play Axis) de la page Classement, par exemple « 2026T3 » ; invite à choisir un trimestre si aucun ou plusieurs sont sélectionnés
	measure 'Trimestre affiche' = SELECTEDVALUE ( Dim_Date[Annee_Trimestre], "Choisir un trimestre (lecture ▶)" )
		displayFolder: 2. Secteur\Affichage
		lineageTag: 079b0f0e-6c02-43c1-b9c7-520a0f7ad56b

