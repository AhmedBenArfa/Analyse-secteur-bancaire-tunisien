/// Dossier du projet sur ce poste (contient donnees_publiees, donnees_reference et docs) : à changer après un clonage
expression CheminDonnees = "D:\Projet\Analyse-secteur-bancaire-tunisien" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: be5fb828-c8ea-446c-be77-dea30810e2f3

	annotation PBI_ResultType = Text

/// Adresse des fichiers bruts du dépôt GitHub public (branche main) : source URL de operations_titres.csv et evenements.csv
expression AdresseDepot = "https://raw.githubusercontent.com/AhmedBenArfa/Analyse-secteur-bancaire-tunisien/main" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 7a0d57a6-360f-4a92-a2d6-b42c1d4bc349

	annotation PBI_ResultType = Text

/// Requête intermédiaire : CSV du dossier donnees_publiees (connecteur Dossier)
expression Fichiers_Donnees =
		// Auteur : Ahmed Ben Arfa
		// Requête intermédiaire (non chargée) : les CSV du dossier versionné donnees_publiees\, lus avec le
		// connecteur Dossier. Les autres requêtes y prennent leur fichier par son nom : un seul endroit dépend
		// du disque. Le dossier est régénéré par python scripts/publier_donnees.py (donnees\ reste local).
		let
		    Source = Folder.Files(CheminDonnees & "\donnees_publiees"),
		    // seulement les CSV posés directement dans donnees_publiees\ (pas LISEZMOI.md)
		    CsvDuDossier = Table.SelectRows(
		        Source,
		        each [Extension] = ".csv" and [Folder Path] = CheminDonnees & "\donnees_publiees\"
		    ),
		    Colonnes = Table.SelectColumns(CsvDuDossier, {"Name", "Content", "Date modified"}),
		    Renommees = Table.RenameColumns(Colonnes, {{"Name", "fichier"}, {"Content", "contenu"}, {"Date modified", "modifie_le"}})
		in
		    Renommees
	lineageTag: cd521bcc-1f81-41b5-bb2f-cbfe7160bfe6

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Requête intermédiaire : toutes les versions des indicateurs trimestriels, typées
expression Versions =
		// Auteur : Ahmed Ben Arfa
		// Requête intermédiaire (non chargée) : toutes les versions de chaque valeur des indicateurs trimestriels
		// (initiale, révisée par le document suivant, 31/12 provisoire), une ligne par banque × trimestre ×
		// indicateur × mesure (trim / cumul) × version. Fait_Indicateurs et Revisions en partent.
		let
		    Fichier = Fichiers_Donnees{[fichier = "indicateurs_versions.csv"]}[contenu],
		    Source = Csv.Document(Fichier, [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    // le CSV écrit les décimales avec un point : types appliqués avec les paramètres régionaux en-US
		    Types = Table.TransformColumnTypes(
		        EnTetes,
		        {
		            {"banque", type text}, {"trimestre", type text}, {"date_arrete", type date},
		            {"annee", Int64.Type}, {"num_trimestre", Int64.Type}, {"code_indicateur", type text},
		            {"mesure", type text}, {"version", type text}, {"valeur_mdt", type number},
		            {"fichier", type text}, {"page", Int64.Type}, {"valeur_retenue", type number},
		            {"source_valeur", type text}, {"ecart_vs_retenue", type number},
		            {"statut_revision", type text}, {"note_definition", type text},
		            {"mention_retraitement", type text}, {"rupture_serie", type text},
		            {"detail_rupture", type text}
		        },
		        "en-US"
		    ),
		    // cases vides du CSV (valeur non disponible, pas de note) : null, jamais zéro
		    VidesEnNull = Table.ReplaceValue(
		        Types, "", null, Replacer.ReplaceValue,
		        {"statut_revision", "note_definition", "mention_retraitement", "rupture_serie", "detail_rupture"}
		    )
		in
		    VidesEnNull
	lineageTag: 6c06666e-3349-47c6-b853-041b53c53608

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Requête intermédiaire : opérations sur titres (GitHub), facteurs d'ajustement de la Bourse et facteurs cumulés
expression Operations_Titres =
		// Auteur : Ahmed Ben Arfa
		// Requête intermédiaire (non chargée) : opérations sur titres des 12 banques (dividendes, attributions
		// gratuites, division du nominal, souscription), lues sur GitHub (source URL), avec le facteur
		// d'ajustement publié par la Bourse et les facteurs cumulés qui ajusteront les cours de Fait_Cours
		// (spécification 7.5). Cours ajusté d'une séance = cours × produit des facteurs des opérations postérieures.
		let
		    // Web.Contents avec RelativePath : l'adresse de base reste fixe (actualisation possible en ligne)
		    Source = Csv.Document(
		        Web.Contents(AdresseDepot, [RelativePath = "operations_titres.csv"]),
		        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    // décimales avec un point : types avec les paramètres régionaux en-US
		    Types = Table.TransformColumnTypes(
		        EnTetes,
		        {
		            {"banque", type text}, {"isin", type text}, {"date_effet", type date}, {"types", type text},
		            {"details", type text}, {"dividende", type number}, {"date_veille", type date},
		            {"cloture_veille", type number}, {"cours_reference_publie", type number},
		            {"cours_reference_theorique", type number}, {"ecart_theorique", type number},
		            {"bulletin", type text}, {"page_cours", Int64.Type}, {"page_avis", Int64.Type},
		            {"extrait_avis", type text}, {"detection", type text}
		        },
		        "en-US"
		    ),
		    // facteur de la Bourse : cours de référence publié le jour de l'opération / clôture de la veille ;
		    // vide si le cours de référence manque (opération signalée, jamais de facteur inventé)
		    Facteur = Table.AddColumn(
		        Types, "facteur",
		        each if [cours_reference_publie] = null or [cloture_veille] = null then null
		            else [cours_reference_publie] / [cloture_veille],
		        type nullable number
		    ),
		    // colonne conditionnelle : opération sur le capital (tout sauf un dividende seul)
		    Capital = Table.AddColumn(Facteur, "capital", each [types] <> "dividende", type logical),
		    // facteur de la série « prix » : 1 pour un dividende seul ; si un dividende est détaché le même jour
		    // qu'une attribution (BT 10/05/2022), il est retiré de la clôture de la veille avant la parité
		    FacteurPrix = Table.AddColumn(
		        Capital, "facteur_prix",
		        each if not [capital] then 1
		            else if [facteur] = null then null
		            else if [dividende] <> null then [cours_reference_publie] / ([cloture_veille] - [dividende])
		            else [facteur],
		        type nullable number
		    ),
		    // table gardée en mémoire : les cumuls la parcourent pour chaque ligne sans relire le fichier en ligne
		    EnMemoire = Table.Buffer(FacteurPrix),
		    // facteurs cumulés : produit des facteurs de la banque pour cette opération et les suivantes ; une
		    // séance antérieure à l'opération prend le cumul de la première opération qui la suit
		    CumulPrix = Table.AddColumn(
		        EnMemoire, "facteur_cumule_prix",
		        (op) => List.Product(List.RemoveNulls(Table.SelectRows(
		            EnMemoire, (autre) => autre[banque] = op[banque] and autre[date_effet] >= op[date_effet])[facteur_prix])),
		        type number
		    ),
		    CumulRendement = Table.AddColumn(
		        CumulPrix, "facteur_cumule_rendement",
		        (op) => List.Product(List.RemoveNulls(Table.SelectRows(
		            EnMemoire, (autre) => autre[banque] = op[banque] and autre[date_effet] >= op[date_effet])[facteur])),
		        type number
		    ),
		    Triees = Table.Sort(CumulRendement, {{"banque", Order.Ascending}, {"date_effet", Order.Ascending}})
		in
		    Triees
	lineageTag: cca2c5c2-a756-43c6-b8b0-e904714c2b97

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
