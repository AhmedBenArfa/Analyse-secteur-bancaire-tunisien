// Auteur : Ahmed Ben Arfa
// Mesures DAX du rapport (spécification 7), dans la table Mesures du modèle : écrites dans le TMDL par
// python scripts/ecrire_tmdl_table.py mesures. Chaque mesure : une ligne « // [dossier | format] description »
// (format « texte » : mesure qui renvoie du texte), puis « MEASURE Mesures[Nom] = » et son expression,
// jusqu'à la ligne vide suivante.
// Règles : aucune valeur absente remplacée par zéro ; un flux annuel vient du cumul publié, jamais de la
// somme des trimestres ; un encours (stock) se lit à une date, jamais additionné dans le temps.

// ===== 1. Bases (spécification 7.1) =====

// [1. Bases\Intermédiaires | #,0.000] Somme des valeurs retenues du trimestre seul ; vide si la sélection couvre plusieurs dates d'arrêté (jamais la somme de plusieurs trimestres)
MEASURE Mesures[Valeur Trim] =
    IF ( DISTINCTCOUNT ( Fait_Indicateurs[date_arrete] ) = 1, SUM ( Fait_Indicateurs[Valeur_Trim] ) )

// [1. Bases\Intermédiaires | #,0.000] Somme des valeurs retenues du cumul depuis janvier (flux) ou du solde (stock) ; vide si la sélection couvre plusieurs dates d'arrêté
MEASURE Mesures[Valeur Cumul] =
    IF ( DISTINCTCOUNT ( Fait_Indicateurs[date_arrete] ) = 1, SUM ( Fait_Indicateurs[Valeur_Cumul] ) )

// [1. Bases\Flux du trimestre | #,0.000] Produit net bancaire du trimestre seul (MDT)
MEASURE Mesures[PNB] =
    CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "PNB" )

// [1. Bases\Flux du trimestre | #,0.000] Charges opératoires publiées du trimestre (contenu propre à chaque banque : Definitions_Charges)
MEASURE Mesures[Charges operatoires] =
    CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "CHG_OPER" )

// [1. Bases\Flux du trimestre | #,0.000] Frais de personnel du trimestre
MEASURE Mesures[Frais personnel] =
    CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "FRAIS_PERS" )

// [1. Bases\Flux du trimestre | #,0.000] Charges générales d'exploitation du trimestre
MEASURE Mesures[Charges generales] =
    CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "CHG_GEN" )

// [1. Bases\Flux du trimestre | #,0.000] Intérêts perçus − intérêts encourus du trimestre ; vide si l'un des deux manque (un vide n'est jamais lu comme zéro)
MEASURE Mesures[Marge interets] =
    VAR Percus = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "INT_PERCUS" )
    VAR Encourus = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "INT_ENCOURUS" )
    RETURN
        IF ( NOT ISBLANK ( Percus ) && NOT ISBLANK ( Encourus ), Percus - Encourus )

// [1. Bases\Flux du trimestre | #,0.000] Commissions en produits − commissions encourues du trimestre ; vide si l'une des deux manque
MEASURE Mesures[Marge commissions] =
    VAR Produits = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "COMM_PROD" )
    VAR Charges = CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "COMM_CHG" )
    RETURN
        IF ( NOT ISBLANK ( Produits ) && NOT ISBLANK ( Charges ), Produits - Charges )

// [1. Bases\Flux du trimestre | #,0.000] Revenus du portefeuille-titres du trimestre
MEASURE Mesures[Revenus portefeuille] =
    CALCULATE ( [Valeur Trim], Dim_Indicateur[code_indicateur] = "REV_PORTEF" )

// [1. Bases\Intermédiaires | #,0.000] PNB cumulé depuis janvier à une date d'arrêté
MEASURE Mesures[PNB cumul brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "PNB" )

// [1. Bases\Flux cumulés | #,0.000] PNB cumulé publié au dernier trimestre de la sélection qui a une valeur (jamais la somme des trimestres)
MEASURE Mesures[PNB depuis debut annee] =
    CALCULATE ( [PNB cumul brut], LASTNONBLANK ( Dim_Date[Date], [PNB cumul brut] ) )

// [1. Bases\Flux cumulés | #,0.000] PNB de l'année : cumul publié au 31/12 ; vide pour une année sans T4 publié ou si plusieurs années sont sélectionnées
MEASURE Mesures[PNB annuel] =
    CALCULATE ( [PNB cumul brut], Dim_Date[Trimestre] = "T4" )

// [1. Bases\Intermédiaires | #,0.000] Encours des crédits à une date d'arrêté
MEASURE Mesures[Credits brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CREDITS" )

// [1. Bases\Encours | #,0.000] Encours des crédits à la dernière date de la sélection qui a une valeur (jamais additionné dans le temps)
MEASURE Mesures[Credits] =
    CALCULATE ( [Credits brut], LASTNONBLANK ( Dim_Date[Date], [Credits brut] ) )

// [1. Bases\Intermédiaires | #,0.000] Encours des dépôts à une date d'arrêté
MEASURE Mesures[Depots brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEPOTS" )

// [1. Bases\Encours | #,0.000] Encours des dépôts de la clientèle à la dernière date de la sélection qui a une valeur
MEASURE Mesures[Depots] =
    CALCULATE ( [Depots brut], LASTNONBLANK ( Dim_Date[Date], [Depots brut] ) )

// [1. Bases\Intermédiaires | #,0.000] Dépôts à vue à une date d'arrêté
MEASURE Mesures[Depots a vue brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_VUE" )

// [1. Bases\Encours | #,0.000] Dépôts à vue à la dernière date de la sélection qui a une valeur
MEASURE Mesures[Depots a vue] =
    CALCULATE ( [Depots a vue brut], LASTNONBLANK ( Dim_Date[Date], [Depots a vue brut] ) )

// [1. Bases\Intermédiaires | #,0.000] Dépôts d'épargne à une date d'arrêté
MEASURE Mesures[Depots epargne brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_EPARGNE" )

// [1. Bases\Encours | #,0.000] Dépôts d'épargne à la dernière date de la sélection qui a une valeur
MEASURE Mesures[Depots epargne] =
    CALCULATE ( [Depots epargne brut], LASTNONBLANK ( Dim_Date[Date], [Depots epargne brut] ) )

// [1. Bases\Intermédiaires | #,0.000] Dépôts à terme à une date d'arrêté (publiés par une partie des banques seulement)
MEASURE Mesures[Depots terme brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "DEP_TERME" )

// [1. Bases\Encours | #,0.000] Dépôts à terme à la dernière date de la sélection qui a une valeur (publiés par une partie des banques seulement)
MEASURE Mesures[Depots terme] =
    CALCULATE ( [Depots terme brut], LASTNONBLANK ( Dim_Date[Date], [Depots terme brut] ) )

// [1. Bases\Intermédiaires | #,0.000] Emprunts et ressources spéciales à une date d'arrêté
MEASURE Mesures[Emprunts brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "EMPRUNTS" )

// [1. Bases\Encours | #,0.000] Emprunts et ressources spéciales à la dernière date de la sélection qui a une valeur
MEASURE Mesures[Emprunts] =
    CALCULATE ( [Emprunts brut], LASTNONBLANK ( Dim_Date[Date], [Emprunts brut] ) )

// [1. Bases\Intermédiaires | #,0.000] Capitaux propres trimestriels à une date d'arrêté (définition propre à chaque banque)
MEASURE Mesures[Capitaux propres hors resultat brut] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CAP_PROPRES" )

// [1. Bases\Fiche banque | #,0.000] Capitaux propres trimestriels publiés : FICHE BANQUE SEULEMENT, avec Definitions_Capitaux_Propres ; les comparaisons entre banques utilisent les capitaux propres du bilan (7.7)
MEASURE Mesures[Capitaux propres hors resultat de la periode] =
    CALCULATE (
        [Capitaux propres hors resultat brut],
        LASTNONBLANK ( Dim_Date[Date], [Capitaux propres hors resultat brut] )
    )

// ===== 2. Secteur : banques présentes, totaux, parts de marché, rangs (spécification 7.4) =====
// Un total du secteur, une part de marché, un rang ou un indice de concentration n'est calculé que si les
// 12 banques sont présentes ; sinon il reste vide, et le nombre de banques présentes s'affiche à côté.

// [2. Secteur\Banques présentes | 0] Nombre de banques du modèle (12)
MEASURE Mesures[Nombre de banques] =
    COUNTROWS ( ALL ( Dim_Banque ) )

// [2. Secteur\Banques présentes | 0] Nombre de banques qui ont un PNB du trimestre pour la sélection (toutes banques confondues, filtre de banque ignoré)
MEASURE Mesures[Banques presentes PNB] =
    COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [PNB] ) ) )

// [2. Secteur\Intermédiaires | Short Date] Dernière date d'arrêté de la sélection où au moins une banque a un encours de crédits
MEASURE Mesures[Date fin credits] =
    CALCULATE (
        MAX ( Fait_Indicateurs[date_arrete] ),
        REMOVEFILTERS ( Dim_Banque ),
        Dim_Indicateur[code_indicateur] = "CREDITS",
        NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
    )

// [2. Secteur\Banques présentes | 0] Nombre de banques qui ont un encours de crédits à la dernière date de la sélection
MEASURE Mesures[Banques presentes credits] =
    VAR DateFin = [Date fin credits]
    RETURN
        CALCULATE (
            COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Credits brut] ) ) ),
            REMOVEFILTERS ( Dim_Date ),
            Dim_Date[Date] = DateFin
        )

// [2. Secteur\Intermédiaires | Short Date] Dernière date d'arrêté de la sélection où au moins une banque a un encours de dépôts
MEASURE Mesures[Date fin depots] =
    CALCULATE (
        MAX ( Fait_Indicateurs[date_arrete] ),
        REMOVEFILTERS ( Dim_Banque ),
        Dim_Indicateur[code_indicateur] = "DEPOTS",
        NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
    )

// [2. Secteur\Banques présentes | 0] Nombre de banques qui ont un encours de dépôts à la dernière date de la sélection
MEASURE Mesures[Banques presentes depots] =
    VAR DateFin = [Date fin depots]
    RETURN
        CALCULATE (
            COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Depots brut] ) ) ),
            REMOVEFILTERS ( Dim_Date ),
            Dim_Date[Date] = DateFin
        )

// [2. Secteur\Banques présentes | 0] Nombre de banques qui ont une valeur (cumul ou solde) pour l'indicateur choisi à la date sélectionnée ; vide si aucun ou plusieurs indicateurs sont choisis
MEASURE Mesures[Banques presentes] =
    IF (
        HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
        COUNTROWS ( FILTER ( ALL ( Dim_Banque ), NOT ISBLANK ( [Valeur Cumul] ) ) )
    )

// [2. Secteur\Totaux | #,0.000] PNB du trimestre des 12 banques ; vide si une banque manque
MEASURE Mesures[PNB secteur] =
    IF (
        [Banques presentes PNB] = [Nombre de banques],
        CALCULATE ( [PNB], REMOVEFILTERS ( Dim_Banque ) )
    )

// [2. Secteur\Totaux | #,0.000] Encours de crédits des 12 banques à la dernière date de la sélection ; vide si une banque manque à cette date
MEASURE Mesures[Credits secteur] =
    VAR DateFin = [Date fin credits]
    RETURN
        IF (
            [Banques presentes credits] = [Nombre de banques],
            CALCULATE ( [Credits brut], REMOVEFILTERS ( Dim_Banque ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
        )

// [2. Secteur\Totaux | #,0.000] Encours de dépôts des 12 banques à la dernière date de la sélection ; vide si une banque manque à cette date
MEASURE Mesures[Depots secteur] =
    VAR DateFin = [Date fin depots]
    RETURN
        IF (
            [Banques presentes depots] = [Nombre de banques],
            CALCULATE ( [Depots brut], REMOVEFILTERS ( Dim_Banque ), REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )
        )

// [2. Secteur\Parts de marché | 0.00 %] Part de la banque dans le PNB du trimestre des 12 banques
MEASURE Mesures[Part de marche PNB] =
    DIVIDE ( [PNB], [PNB secteur] )

// [2. Secteur\Parts de marché | 0.00 %] Part de la banque dans l'encours de crédits des 12 banques
MEASURE Mesures[Part de marche credits] =
    DIVIDE ( [Credits], [Credits secteur] )

// [2. Secteur\Parts de marché | 0.00 %] Part de la banque dans l'encours de dépôts des 12 banques
MEASURE Mesures[Part de marche depots] =
    DIVIDE ( [Depots], [Depots secteur] )

// [2. Secteur\Concentration | #,0] Indice de Herfindahl-Hirschman du PNB : somme des carrés des parts de marché × 10 000 (de 833 si les 12 banques étaient égales à 10 000 pour une seule banque) ; vide si une banque manque
MEASURE Mesures[HHI PNB] =
    IF (
        NOT ISBLANK ( [PNB secteur] ),
        SUMX ( ALL ( Dim_Banque ), [Part de marche PNB] ^ 2 ) * 10000
    )

// [2. Secteur\Rangs | 0] Rang de la banque par PNB du trimestre (1 = le plus élevé) ; vide hors d'une ligne de banque ou si une banque manque
MEASURE Mesures[Rang PNB] =
    IF (
        HASONEVALUE ( Dim_Banque[code_banque] ) && NOT ISBLANK ( [PNB] ) && NOT ISBLANK ( [PNB secteur] ),
        RANKX ( ALL ( Dim_Banque ), [PNB], , DESC, DENSE )
    )

// [2. Secteur\Dernier trimestre complet | texte] Dernier trimestre où les 12 banques ont publié PNB, crédits et dépôts (colonne Choix_Trimestre de Dim_Date), par exemple « 2026T3 »
MEASURE Mesures[Dernier trimestre complet] =
    CALCULATE (
        SELECTEDVALUE ( Dim_Date[Annee_Trimestre] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[Choix_Trimestre] = "Dernier trimestre complet"
    )

// [2. Secteur\Dernier trimestre complet | Short Date] Date d'arrêté du dernier trimestre complet
MEASURE Mesures[Date dernier trimestre complet] =
    CALCULATE (
        MAX ( Dim_Date[Date] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[Choix_Trimestre] = "Dernier trimestre complet"
    )

// ===== 3. Ratios (spécification 7.2) et comparaison du coefficient au secteur (7.4) =====
// Toutes les comparaisons entre banques utilisent le coefficient d'exploitation harmonisé ; le coefficient
// publié (charges opératoires / PNB) n'est qu'une information, avec la définition de chaque banque.

// [3. Ratios\Coefficient d'exploitation | 0.0 %] Coefficient publié = charges opératoires publiées / PNB du trimestre ; POUR INFORMATION (le contenu des charges opératoires varie d'une banque à l'autre : Definitions_Charges), jamais classé
MEASURE Mesures[Coef exploitation publie] =
    DIVIDE ( [Charges operatoires], [PNB] )

// [3. Ratios\Coefficient d'exploitation | 0.0 %] Coefficient harmonisé = (frais de personnel + charges générales) / PNB du trimestre, sur les banques qui publient les trois montants ; sert à toutes les comparaisons et classements
MEASURE Mesures[Coef exploitation harmonise] =
    VAR Lignes =
        ADDCOLUMNS (
            VALUES ( Dim_Banque[code_banque] ),
            "@Pers", [Frais personnel],
            "@Gen", [Charges generales],
            "@PNB", [PNB]
        )
    VAR Completes =
        FILTER ( Lignes, NOT ISBLANK ( [@Pers] ) && NOT ISBLANK ( [@Gen] ) && NOT ISBLANK ( [@PNB] ) )
    RETURN
        DIVIDE ( SUMX ( Completes, [@Pers] + [@Gen] ), SUMX ( Completes, [@PNB] ) )

// [3. Ratios\Intermédiaires | #,0.000] Frais de personnel de l'année : cumul publié au 31/12
MEASURE Mesures[Frais personnel annuel] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "FRAIS_PERS", Dim_Date[Trimestre] = "T4" )

// [3. Ratios\Intermédiaires | #,0.000] Charges générales d'exploitation de l'année : cumul publié au 31/12
MEASURE Mesures[Charges generales annuel] =
    CALCULATE ( [Valeur Cumul], Dim_Indicateur[code_indicateur] = "CHG_GEN", Dim_Date[Trimestre] = "T4" )

// [3. Ratios\Coefficient d'exploitation | 0.0 %] Coefficient harmonisé de l'année, à partir des cumuls publiés au 31/12 (jamais la somme des trimestres) ; vide pour une année sans T4 publié
MEASURE Mesures[Coef exploitation harmonise annuel] =
    VAR Lignes =
        ADDCOLUMNS (
            VALUES ( Dim_Banque[code_banque] ),
            "@Pers", [Frais personnel annuel],
            "@Gen", [Charges generales annuel],
            "@PNB", [PNB annuel]
        )
    VAR Completes =
        FILTER ( Lignes, NOT ISBLANK ( [@Pers] ) && NOT ISBLANK ( [@Gen] ) && NOT ISBLANK ( [@PNB] ) )
    RETURN
        DIVIDE ( SUMX ( Completes, [@Pers] + [@Gen] ), SUMX ( Completes, [@PNB] ) )

// [3. Ratios\Comparaison au secteur | 0] Nombre de banques qui publient frais de personnel, charges générales et PNB pour le trimestre sélectionné
MEASURE Mesures[Banques presentes coef] =
    COUNTROWS (
        FILTER (
            ALL ( Dim_Banque ),
            NOT ISBLANK ( [Frais personnel] ) && NOT ISBLANK ( [Charges generales] ) && NOT ISBLANK ( [PNB] )
        )
    )

// [3. Ratios\Comparaison au secteur | 0.0 %] Coefficient harmonisé du secteur (moyenne pondérée par le PNB : somme des charges / somme des PNB des 12 banques) ; vide si une banque manque
MEASURE Mesures[Coef secteur] =
    IF (
        [Banques presentes coef] = [Nombre de banques],
        CALCULATE ( [Coef exploitation harmonise], REMOVEFILTERS ( Dim_Banque ) )
    )

// [3. Ratios\Comparaison au secteur | 0.0 %] Médiane des coefficients harmonisés des 12 banques (banque « du milieu », insensible aux extrêmes) ; vide si une banque manque
MEASURE Mesures[Coef mediane] =
    IF (
        [Banques presentes coef] = [Nombre de banques],
        MEDIANX ( ALL ( Dim_Banque ), [Coef exploitation harmonise] )
    )

// [3. Ratios\Comparaison au secteur | +0.0 %;-0.0 %;0.0 %] Écart du coefficient harmonisé de la banque à la médiane (négatif = plus efficace que la banque médiane) ; vide hors d'une ligne de banque
MEASURE Mesures[Ecart coef / mediane] =
    VAR Coef = [Coef exploitation harmonise]
    VAR Mediane = [Coef mediane]
    RETURN
        IF (
            HASONEVALUE ( Dim_Banque[code_banque] ) && NOT ISBLANK ( Coef ) && NOT ISBLANK ( Mediane ),
            Coef - Mediane
        )

// [3. Ratios\Comparaison au secteur | 0] Rang du coefficient harmonisé (1 = le plus bas, donc la banque la plus efficace) ; vide hors d'une ligne de banque ou si une banque manque
MEASURE Mesures[Rang coef] =
    IF (
        HASONEVALUE ( Dim_Banque[code_banque] )
            && NOT ISBLANK ( [Coef exploitation harmonise] )
            && [Banques presentes coef] = [Nombre de banques],
        RANKX ( ALL ( Dim_Banque ), [Coef exploitation harmonise], , ASC, DENSE )
    )

// [3. Ratios\Structure du PNB | 0.0 %] Marge d'intérêts / PNB du trimestre
MEASURE Mesures[Part marge interets] =
    DIVIDE ( [Marge interets], [PNB] )

// [3. Ratios\Structure du PNB | 0.0 %] Marge sur commissions / PNB du trimestre
MEASURE Mesures[Part commissions] =
    DIVIDE ( [Marge commissions], [PNB] )

// [3. Ratios\Structure du PNB | 0.0 %] Revenus du portefeuille-titres / PNB du trimestre
MEASURE Mesures[Part portefeuille] =
    DIVIDE ( [Revenus portefeuille], [PNB] )

// [3. Ratios\Structure du PNB | 0.0 %] Frais de personnel / PNB du trimestre
MEASURE Mesures[Frais personnel / PNB] =
    DIVIDE ( [Frais personnel], [PNB] )

// [3. Ratios\Bilan | 0.0 %] Encours des crédits / encours des dépôts en fin de période (plus de 100 % : la banque prête plus qu'elle ne collecte de dépôts)
MEASURE Mesures[Credits / Depots] =
    DIVIDE ( [Credits], [Depots] )

// [3. Ratios\Bilan | 0.0 %] Dépôts à vue / total des dépôts en fin de période (ressources peu coûteuses)
MEASURE Mesures[Part depots a vue] =
    DIVIDE ( [Depots a vue], [Depots] )

// ===== 4. Croissances, tendances et annotations (spécification 7.3) =====
// Variation sur un an : TOUJOURS Variations_Comparables (valeur N et valeur N-1 du même document), jamais
// SAMEPERIODLASTYEAR ni DATEADD sur Fait_Indicateurs (deux documents de méthodes parfois différentes).
// Plusieurs banques : somme des N contre somme des N-1, seulement si TOUTES les banques de la sélection ont
// les deux valeurs (pour le secteur : les 12) ; dénominateur en valeur absolue, comme Variation_Pct.

// [4. Croissances\Intermédiaires | #,0.000] Somme des valeurs N du trimestre seul (même document que N-1) ; vide si plusieurs dates d'arrêté
MEASURE Mesures[VC N trim] =
    IF (
        DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
        CALCULATE ( SUM ( Variations_Comparables[valeur_N] ), Variations_Comparables[mesure] = "trim" )
    )

// [4. Croissances\Intermédiaires | #,0.000] Somme des valeurs N-1 du trimestre seul, lues dans le document de l'année N
MEASURE Mesures[VC N1 trim] =
    IF (
        DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
        CALCULATE ( SUM ( Variations_Comparables[valeur_N1] ), Variations_Comparables[mesure] = "trim" )
    )

// [4. Croissances\Intermédiaires | #,0.000] Somme des valeurs N du cumul depuis janvier (flux) ou du solde (stock)
MEASURE Mesures[VC N cumul] =
    IF (
        DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
        CALCULATE ( SUM ( Variations_Comparables[valeur_N] ), Variations_Comparables[mesure] = "cumul" )
    )

// [4. Croissances\Intermédiaires | #,0.000] Somme des valeurs N-1 du cumul ou du solde, lues dans le document de l'année N
MEASURE Mesures[VC N1 cumul] =
    IF (
        DISTINCTCOUNT ( Variations_Comparables[date_arrete] ) = 1,
        CALCULATE ( SUM ( Variations_Comparables[valeur_N1] ), Variations_Comparables[mesure] = "cumul" )
    )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] Variation sur un an du trimestre seul, pour l'indicateur choisi ; vide si une banque de la sélection n'a pas N et N-1
MEASURE Mesures[Var A/A trimestre %] =
    IF (
        HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
        VAR Lignes =
            ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@N", [VC N trim], "@N1", [VC N1 trim] )
        VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@N] ) && NOT ISBLANK ( [@N1] ) )
        VAR N = SUMX ( Completes, [@N] )
        VAR N1 = SUMX ( Completes, [@N1] )
        RETURN
            IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), DIVIDE ( N - N1, ABS ( N1 ) ) )
    )

// [4. Croissances\Intermédiaires | +0.0 %;-0.0 %;0.0 %] Variation sur un an du cumul ou du solde à une date d'arrêté, pour l'indicateur choisi
MEASURE Mesures[Var A/A cumul a la date %] =
    IF (
        HASONEVALUE ( Dim_Indicateur[code_indicateur] ),
        VAR Lignes =
            ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@N", [VC N cumul], "@N1", [VC N1 cumul] )
        VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@N] ) && NOT ISBLANK ( [@N1] ) )
        VAR N = SUMX ( Completes, [@N] )
        VAR N1 = SUMX ( Completes, [@N1] )
        RETURN
            IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), DIVIDE ( N - N1, ABS ( N1 ) ) )
    )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] Variation sur un an du cumul depuis janvier (flux) ou du solde (stock), à la dernière date de la sélection qui a une valeur
MEASURE Mesures[Var A/A cumul %] =
    VAR DateFin =
        CALCULATE ( MAX ( Variations_Comparables[date_arrete] ), Variations_Comparables[mesure] = "cumul" )
    RETURN
        CALCULATE ( [Var A/A cumul a la date %], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] PNB du trimestre seul : variation sur un an (même document)
MEASURE Mesures[Var PNB A/A %] =
    CALCULATE ( [Var A/A trimestre %], Dim_Indicateur[code_indicateur] = "PNB" )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] PNB cumulé depuis janvier : variation sur un an (même document)
MEASURE Mesures[Var PNB cumul A/A %] =
    CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "PNB" )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] PNB de l'année : variation sur un an du cumul au 31/12, dans le document du T4
MEASURE Mesures[Var PNB annuel A/A %] =
    CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "PNB", Dim_Date[Trimestre] = "T4" )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] Charges opératoires cumulées : variation sur un an (contenu propre à chaque banque, stable dans un même document)
MEASURE Mesures[Var Charges operatoires A/A %] =
    CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "CHG_OPER" )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] Encours des crédits : variation sur un an
MEASURE Mesures[Var Credits A/A %] =
    CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "CREDITS" )

// [4. Croissances\Sur un an | +0.0 %;-0.0 %;0.0 %] Encours des dépôts : variation sur un an
MEASURE Mesures[Var Depots A/A %] =
    CALCULATE ( [Var A/A cumul %], Dim_Indicateur[code_indicateur] = "DEPOTS" )

// [4. Croissances\Sur un trimestre | #,0.000] PNB du trimestre précédent (document du trimestre précédent : à lire avec les marqueurs de rupture)
MEASURE Mesures[PNB T-1] =
    CALCULATE ( [PNB], DATEADD ( Dim_Date[Date], -1, QUARTER ) )

// [4. Croissances\Sur un trimestre | +0.0 %;-0.0 %;0.0 %] PNB : variation par rapport au trimestre précédent (deux documents successifs, pas d'autre source) ; vide si une banque de la sélection manque à l'un des deux trimestres
MEASURE Mesures[Var PNB T/T %] =
    VAR Lignes =
        ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@P", [PNB], "@P1", [PNB T-1] )
    VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@P] ) && NOT ISBLANK ( [@P1] ) )
    VAR P = SUMX ( Completes, [@P] )
    VAR P1 = SUMX ( Completes, [@P1] )
    RETURN
        IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), DIVIDE ( P - P1, ABS ( P1 ) ) )

// [4. Croissances\Tendance | #,0.000] PNB des 4 derniers trimestres publiés jusqu'à la dernière date de la sélection : indicateur de TENDANCE (somme de trimestres), jamais un chiffre annuel ; vide s'il manque un trimestre ou une banque de la sélection
MEASURE Mesures[PNB 4T glissants] =
    VAR Fin = CALCULATE ( MAX ( Fait_Indicateurs[date_arrete] ), Dim_Indicateur[code_indicateur] = "PNB" )
    VAR NbBanques = COUNTROWS ( VALUES ( Dim_Banque[code_banque] ) )
    VAR Trimestres =
        CALCULATETABLE (
            ADDCOLUMNS (
                VALUES ( Dim_Date[Cle_Trimestre] ),
                "@PNB", [PNB],
                "@Banques", COUNTROWS ( FILTER ( VALUES ( Dim_Banque[code_banque] ), NOT ISBLANK ( [PNB] ) ) )
            ),
            REMOVEFILTERS ( Dim_Date ),
            Dim_Date[Date] > EDATE ( Fin, -12 ),
            Dim_Date[Date] <= Fin
        )
    VAR Complets = FILTER ( Trimestres, [@Banques] = NbBanques )
    RETURN
        IF ( NOT ISBLANK ( Fin ) && COUNTROWS ( Complets ) = 4, SUMX ( Complets, [@PNB] ) )

// [4. Croissances\Sur plusieurs années | +0.0 %;-0.0 %;0.0 %] Croissance annuelle moyenne du PNB de 2020 à 2025 : enchaînement des 5 variations annuelles comparables (2021 à 2025, chacune dans son document T4), jamais 2025 / 2020 entre deux documents ; vide s'il en manque une
MEASURE Mesures[TCAM PNB 2020-2025] =
    VAR Annees = GENERATESERIES ( 2021, 2025 )
    VAR Variations =
        ADDCOLUMNS (
            Annees,
            "@Var",
                VAR A = [Value]
                RETURN
                    CALCULATE ( [Var PNB annuel A/A %], REMOVEFILTERS ( Dim_Date ), Dim_Date[Annee] = A )
        )
    VAR Completes = COUNTROWS ( FILTER ( Variations, NOT ISBLANK ( [@Var] ) ) )
    RETURN
        IF ( Completes = 5, PRODUCTX ( Variations, 1 + [@Var] ) ^ ( 1 / 5 ) - 1 )

// [4. Croissances\Annotations | texte] Description des événements (evenements.csv) de la banque, de l'indicateur et de la date du point ; un par ligne
MEASURE Mesures[Evenement texte] =
    CONCATENATEX ( VALUES ( Evenements[description] ), Evenements[description], UNICHAR ( 10 ) )

// [4. Croissances\Annotations | #,0.000] Montant cité par les événements du point (MDT)
MEASURE Mesures[Evenement montant MDT] =
    SUM ( Evenements[montant_mdt] )

// [4. Croissances\Annotations | 0] Nombre d'événements du point
MEASURE Mesures[Nb evenements] =
    COUNTROWS ( Evenements )

// [4. Croissances\Annotations | #,0.000] Marqueur de rupture de série : PNB du trimestre là où la période a été révisée de plus de 2 % sur le cumul (série de points à superposer à la courbe)
MEASURE Mesures[Rupture PNB] =
    IF (
        CALCULATE (
            COUNTROWS ( Fait_Indicateurs ),
            Fait_Indicateurs[Rupture_Trim] = "oui",
            Dim_Indicateur[code_indicateur] = "PNB"
        ) > 0,
        [PNB]
    )

// [4. Croissances\Annotations | #,0.000] Marqueur de rupture de série sur le PNB cumulé depuis janvier
MEASURE Mesures[Rupture PNB cumul] =
    IF (
        CALCULATE (
            COUNTROWS ( Fait_Indicateurs ),
            Fait_Indicateurs[Rupture_Cumul] = "oui",
            Dim_Indicateur[code_indicateur] = "PNB"
        ) > 0,
        [PNB depuis debut annee]
    )

// ===== 5. Rentabilité : ROE et ROA (spécification 7.7) =====
// Source : états financiers individuels (Fait_Etats_Financiers), au 30/06 et au 31/12 seulement : ROE et ROA sont
// semestriels et annuels, jamais trimestriels. Résultat net avant modifications comptables, annualisé (× 2 au
// 30/06) ; capitaux propres et total de l'actif du BILAN, moyenne de l'ouverture (31/12/N-1) et de la date.
// Plusieurs banques : seulement si toutes les banques de la sélection ont les valeurs (secteur : les 12).

// [5. Rentabilité\Intermédiaires | #,0.000] Somme des valeurs retenues des états financiers ; vide si plusieurs dates d'arrêté
MEASURE Mesures[EF valeur] =
    IF ( DISTINCTCOUNT ( Fait_Etats_Financiers[date_arrete] ) = 1, SUM ( Fait_Etats_Financiers[valeur_mdt] ) )

// [5. Rentabilité\Intermédiaires | #,0.000] Résultat net (avant modifications comptables) à une date d'arrêté, cumulé depuis le 1er janvier
MEASURE Mesures[Resultat net brut] =
    CALCULATE ( [EF valeur], Dim_Indicateur[code_indicateur] = "RES_NET" )

// [5. Rentabilité\Intermédiaires | #,0.000] Capitaux propres du bilan (résultat inclus) à une date d'arrêté
MEASURE Mesures[Cap propres EF brut] =
    CALCULATE ( [EF valeur], Dim_Indicateur[code_indicateur] = "CAP_PROPRES_EF" )

// [5. Rentabilité\Intermédiaires | #,0.000] Total de l'actif du bilan à une date d'arrêté
MEASURE Mesures[Total actif brut] =
    CALCULATE ( [EF valeur], Dim_Indicateur[code_indicateur] = "TOTAL_ACTIF" )

// [5. Rentabilité\Intermédiaires | #,0.000] Résultat net annualisé à une date d'arrêté : × facteur_annualisation (2 au 30/06, 1 au 31/12)
MEASURE Mesures[Resultat net annualise brut] =
    CALCULATE (
        IF (
            DISTINCTCOUNT ( Fait_Etats_Financiers[date_arrete] ) = 1,
            SUMX ( Fait_Etats_Financiers, Fait_Etats_Financiers[valeur_mdt] * Fait_Etats_Financiers[facteur_annualisation] )
        ),
        Dim_Indicateur[code_indicateur] = "RES_NET"
    )

// [5. Rentabilité\Bilan et résultat | Short Date] Dernière date d'arrêté des états financiers (30/06 ou 31/12) de la sélection qui a un résultat net
MEASURE Mesures[Date fin EF] =
    CALCULATE ( MAX ( Fait_Etats_Financiers[date_arrete] ), Dim_Indicateur[code_indicateur] = "RES_NET" )

// [5. Rentabilité\Bilan et résultat | #,0.000] Résultat net publié (avant modifications comptables), cumulé depuis le 1er janvier, à la dernière date de la sélection
MEASURE Mesures[Resultat net] =
    CALCULATE ( [Resultat net brut], LASTNONBLANK ( Dim_Date[Date], [Resultat net brut] ) )

// [5. Rentabilité\Bilan et résultat | #,0.000] Capitaux propres du bilan (résultat inclus) à la dernière date de la sélection : référence de toutes les comparaisons entre banques
MEASURE Mesures[Cap propres EF] =
    CALCULATE ( [Cap propres EF brut], LASTNONBLANK ( Dim_Date[Date], [Cap propres EF brut] ) )

// [5. Rentabilité\Bilan et résultat | #,0.000] Total de l'actif du bilan à la dernière date de la sélection
MEASURE Mesures[Total actif] =
    CALCULATE ( [Total actif brut], LASTNONBLANK ( Dim_Date[Date], [Total actif brut] ) )

// [5. Rentabilité\Intermédiaires | #,0.000] Résultat net annualisé à une date d'arrêté, banque par banque ; vide si une banque de la sélection manque
MEASURE Mesures[Resultat net annualise a la date] =
    VAR Lignes = ADDCOLUMNS ( VALUES ( Dim_Banque[code_banque] ), "@RN", [Resultat net annualise brut] )
    VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@RN] ) )
    RETURN
        IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), SUMX ( Completes, [@RN] ) )

// [5. Rentabilité\Intermédiaires | #,0.000] Capitaux propres moyens à une date d'arrêté : (31/12/N-1 + date) / 2, banque par banque ; vide si l'une des deux valeurs manque (jamais une seule valeur prise pour la moyenne)
MEASURE Mesures[Cap propres moyens a la date] =
    VAR Ouverture = DATE ( YEAR ( MAX ( Dim_Date[Date] ) ) - 1, 12, 31 )
    VAR Lignes =
        ADDCOLUMNS (
            VALUES ( Dim_Banque[code_banque] ),
            "@Fin", [Cap propres EF brut],
            "@Ouv", CALCULATE ( [Cap propres EF brut], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = Ouverture )
        )
    VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@Fin] ) && NOT ISBLANK ( [@Ouv] ) )
    RETURN
        IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), SUMX ( Completes, ( [@Ouv] + [@Fin] ) / 2 ) )

// [5. Rentabilité\Intermédiaires | #,0.000] Total de l'actif moyen à une date d'arrêté : (31/12/N-1 + date) / 2, banque par banque ; vide si l'une des deux valeurs manque
MEASURE Mesures[Total actif moyen a la date] =
    VAR Ouverture = DATE ( YEAR ( MAX ( Dim_Date[Date] ) ) - 1, 12, 31 )
    VAR Lignes =
        ADDCOLUMNS (
            VALUES ( Dim_Banque[code_banque] ),
            "@Fin", [Total actif brut],
            "@Ouv", CALCULATE ( [Total actif brut], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = Ouverture )
        )
    VAR Completes = FILTER ( Lignes, NOT ISBLANK ( [@Fin] ) && NOT ISBLANK ( [@Ouv] ) )
    RETURN
        IF ( COUNTROWS ( Completes ) = COUNTROWS ( Lignes ), SUMX ( Completes, ( [@Ouv] + [@Fin] ) / 2 ) )

// [5. Rentabilité\Bilan et résultat | #,0.000] Résultat net annualisé à la dernière date des états financiers de la sélection (× 2 pour un semestre)
MEASURE Mesures[Resultat net annualise] =
    VAR DateFin = [Date fin EF]
    RETURN
        CALCULATE ( [Resultat net annualise a la date], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )

// [5. Rentabilité\Bilan et résultat | #,0.000] Capitaux propres moyens du bilan à la dernière date des états financiers de la sélection
MEASURE Mesures[Cap propres moyens] =
    VAR DateFin = [Date fin EF]
    RETURN
        CALCULATE ( [Cap propres moyens a la date], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )

// [5. Rentabilité\Bilan et résultat | #,0.000] Total de l'actif moyen à la dernière date des états financiers de la sélection
MEASURE Mesures[Total actif moyen] =
    VAR DateFin = [Date fin EF]
    RETURN
        CALCULATE ( [Total actif moyen a la date], REMOVEFILTERS ( Dim_Date ), Dim_Date[Date] = DateFin )

// [5. Rentabilité\Ratios | 0.0 %] ROE = résultat net annualisé / capitaux propres moyens du bilan, à la dernière date des états financiers de la sélection (semestre annualisé au 30/06, exercice au 31/12) ; résultat semestriel non audité (revue limitée)
MEASURE Mesures[ROE] =
    DIVIDE ( [Resultat net annualise], [Cap propres moyens] )

// [5. Rentabilité\Ratios | 0.00 %] ROA = résultat net annualisé / total de l'actif moyen, à la dernière date des états financiers de la sélection
MEASURE Mesures[ROA] =
    DIVIDE ( [Resultat net annualise], [Total actif moyen] )

// [5. Rentabilité\Ratios | 0.0 %] ROE des 12 banques ensemble (somme des résultats / somme des capitaux propres moyens) ; vide si une banque manque
MEASURE Mesures[ROE secteur] =
    CALCULATE ( [ROE], REMOVEFILTERS ( Dim_Banque ) )

// [5. Rentabilité\Ratios | 0.00 %] ROA des 12 banques ensemble ; vide si une banque manque
MEASURE Mesures[ROA secteur] =
    CALCULATE ( [ROA], REMOVEFILTERS ( Dim_Banque ) )

// ===== 6. Bourse (spécification 7.5) =====
// Cours d'UNE banque à la fois (additionner des cours de banques différentes n'a pas de sens) : vide sinon.
// Performances calculées sur les clôtures AJUSTÉES des opérations sur titres (Fait_Cours, Power Query) ;
// une clôture brute ne sert qu'à l'affichage du cours.

// [6. Bourse\Intermédiaires | #,0.000] Clôture publiée d'une séance, pour une banque ; vide si plusieurs banques ou plusieurs séances
MEASURE Mesures[Cloture brut] =
    IF (
        HASONEVALUE ( Dim_Banque[code_banque] ) && DISTINCTCOUNT ( Fait_Cours[date] ) = 1,
        SUM ( Fait_Cours[cloture] )
    )

// [6. Bourse\Intermédiaires | #,0.000] Clôture ajustée des opérations sur le capital (attributions, divisions, souscriptions) d'une séance, pour une banque
MEASURE Mesures[Cloture ajustee prix brut] =
    IF (
        HASONEVALUE ( Dim_Banque[code_banque] ) && DISTINCTCOUNT ( Fait_Cours[date] ) = 1,
        SUM ( Fait_Cours[cloture_ajustee_prix] )
    )

// [6. Bourse\Intermédiaires | #,0.000] Clôture ajustée de toutes les opérations, dividendes compris, d'une séance, pour une banque
MEASURE Mesures[Cloture ajustee rendement brut] =
    IF (
        HASONEVALUE ( Dim_Banque[code_banque] ) && DISTINCTCOUNT ( Fait_Cours[date] ) = 1,
        SUM ( Fait_Cours[cloture_ajustee_rendement] )
    )

// [6. Bourse\Cours | #,0.000] Dernière clôture publiée de la période (DT), pour une banque
MEASURE Mesures[Dernier cours] =
    CALCULATE ( [Cloture brut], LASTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )

// [6. Bourse\Cours | #,0.000] Première clôture publiée de la période (DT), pour une banque
MEASURE Mesures[Premier cours] =
    CALCULATE ( [Cloture brut], FIRSTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )

// [6. Bourse\Cours | Short Date] Date de la dernière clôture publiée de la période
MEASURE Mesures[Date dernier cours] =
    CALCULATE ( MAX ( Dim_Date[Date] ), LASTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )

// [6. Bourse\Cours | Short Date] Date de la première clôture publiée de la période
MEASURE Mesures[Date premier cours] =
    CALCULATE ( MIN ( Dim_Date[Date] ), FIRSTNONBLANK ( Dim_Date[Date], [Cloture brut] ) )

// [6. Bourse\Performance | +0.0 %;-0.0 %;0.0 %] Performance du prix sur la période : dernière / première clôture ajustée des opérations sur le capital, − 1 (hors dividendes)
MEASURE Mesures[Performance prix] =
    VAR Debut = CALCULATE ( [Cloture ajustee prix brut], FIRSTNONBLANK ( Dim_Date[Date], [Cloture ajustee prix brut] ) )
    VAR Fin = CALCULATE ( [Cloture ajustee prix brut], LASTNONBLANK ( Dim_Date[Date], [Cloture ajustee prix brut] ) )
    RETURN
        IF ( NOT ISBLANK ( Debut ) && NOT ISBLANK ( Fin ), DIVIDE ( Fin, Debut ) - 1 )

// [6. Bourse\Performance | +0.0 %;-0.0 %;0.0 %] Rendement total sur la période, dividendes réinvestis : dernière / première clôture ajustée de toutes les opérations, − 1
MEASURE Mesures[Rendement total] =
    VAR Debut = CALCULATE ( [Cloture ajustee rendement brut], FIRSTNONBLANK ( Dim_Date[Date], [Cloture ajustee rendement brut] ) )
    VAR Fin = CALCULATE ( [Cloture ajustee rendement brut], LASTNONBLANK ( Dim_Date[Date], [Cloture ajustee rendement brut] ) )
    RETURN
        IF ( NOT ISBLANK ( Debut ) && NOT ISBLANK ( Fin ), DIVIDE ( Fin, Debut ) - 1 )

// [6. Bourse\Risque et liquidité | 0.0 %] Volatilité annualisée : écart-type des rendements quotidiens (série rendement total) × racine de 252 séances, pour une banque ; vide sous 20 rendements ; à lire avec l'avertissement de liquidité
MEASURE Mesures[Volatilite annualisee] =
    VAR Rendements = FILTER ( Fait_Cours, NOT ISBLANK ( Fait_Cours[rendement] ) )
    RETURN
        IF (
            HASONEVALUE ( Dim_Banque[code_banque] ) && COUNTROWS ( Rendements ) >= 20,
            STDEVX.S ( Rendements, Fait_Cours[rendement] ) * SQRT ( 252 )
        )

// [6. Bourse\Risque et liquidité | #,0] Nombre de séances de la période
MEASURE Mesures[Seances] =
    COUNTROWS ( Fait_Cours )

// [6. Bourse\Risque et liquidité | #,0] Nombre de séances sans transaction (aucun titre échangé ; la clôture est alors le cours de référence)
MEASURE Mesures[Seances sans transaction] =
    CALCULATE ( [Seances], Fait_Cours[sans_transaction] = TRUE () )

// [6. Bourse\Risque et liquidité | 0.0 %] Part des séances sans transaction dans la période
MEASURE Mesures[Taux seances sans transaction] =
    DIVIDE ( [Seances sans transaction], [Seances] )

// [6. Bourse\Risque et liquidité | 0 %] Seuil au-delà duquel un titre est dit peu liquide (20 % des séances sans transaction)
MEASURE Mesures[Seuil titre peu liquide] =
    0.20

// [6. Bourse\Risque et liquidité | texte] Avertissement affiché pour un titre peu liquide (une banque) : sa volatilité et sa performance reposent sur peu d'échanges
MEASURE Mesures[Avertissement liquidite] =
    IF (
        HASONEVALUE ( Dim_Banque[code_banque] ) && [Taux seances sans transaction] > [Seuil titre peu liquide],
        "Titre peu liquide : " & FORMAT ( [Taux seances sans transaction], "0 %" )
            & " des séances sans transaction ; volatilité et performance à lire avec prudence"
    )

// ===== 7. Affichage et qualité des données (spécification 7.8) =====

// [7. Qualité\Affichage | Short Date] Date d'arrêté la plus récente des indicateurs trimestriels, tous filtres ignorés
MEASURE Mesures[Date derniere donnee] =
    CALCULATE ( MAX ( Fait_Indicateurs[date_arrete] ), REMOVEFILTERS () )

// [7. Qualité\Affichage | texte] Titre du rapport avec la date des dernières données
MEASURE Mesures[Titre rapport] =
    "Banques cotées — données au " & FORMAT ( [Date derniere donnee], "dd/mm/yyyy" )

// [7. Qualité\Affichage | texte] Couleur de mise en forme du coefficient : vert si la banque est plus efficace que la médiane (écart ≤ 0), rouge sinon ; rien si l'écart est vide
MEASURE Mesures[Couleur coef] =
    VAR Ecart = [Ecart coef / mediane]
    RETURN
        IF ( NOT ISBLANK ( Ecart ), IF ( Ecart <= 0, "#2E7D32", "#C62828" ) )

// [7. Qualité\Documents | #,0] Nombre de documents trimestriels (un par banque et par trimestre)
MEASURE Mesures[Nb documents] =
    COUNTROWS ( Controle )

// [7. Qualité\Documents | 0.0 %] Part des documents lus sans aucune alerte ; les autres ont surtout des écarts qui viennent des révisions des banques (Nb ecarts signales), pas d'erreurs d'extraction
MEASURE Mesures[Part documents sans alerte] =
    DIVIDE ( CALCULATE ( [Nb documents], Controle[statut] = "ok" ), [Nb documents] )

// [7. Qualité\Documents | #,0] Documents avec un écart signalé qui vient de la banque (retraitement possible, écart trimestre/cumul, écart composantes), non bloquant
MEASURE Mesures[Nb ecarts signales] =
    CALCULATE (
        [Nb documents],
        Controle[statut] IN { "retraitement possible", "ecart trimestre/cumul", "ecart composantes" }
    )

// [7. Qualité\Documents | #,0] Documents dont le trimestre seul ne vaut pas le cumul moins le cumul précédent (révision de la banque en cours d'année)
MEASURE Mesures[Nb ecarts trim cumul] =
    CALCULATE ( [Nb documents], Controle[statut] = "ecart trimestre/cumul" )

// [7. Qualité\Documents | #,0] Documents dont le total publié ne vaut pas la somme de ses composantes (incohérence de la banque, vérifiée dans le PDF)
MEASURE Mesures[Nb ecarts composantes] =
    CALCULATE ( [Nb documents], Controle[statut] = "ecart composantes" )

// [7. Qualité\Documents | #,0] Documents avec une alerte bloquante (erreur du document de la banque, vérifiée sur l'image)
MEASURE Mesures[Nb documents a verifier] =
    CALCULATE ( [Nb documents], Controle[statut] = "a verifier" )

// [7. Qualité\Documents | #,0] Documents publiés en image, repris du document suivant
MEASURE Mesures[Nb documents illisibles] =
    CALCULATE ( [Nb documents], Controle[statut] = "illisible (image)" )

// [7. Qualité\Documents | #,0] Documents publiés en image, saisis à la main (saisies_manuelles.csv, contrôles de cohérence)
MEASURE Mesures[Nb documents saisis] =
    CALCULATE ( [Nb documents], Controle[statut] = "saisie manuelle" )

// [7. Qualité\Révisions | 0.0 %] Part des cumuls affichés qui viennent d'une version révisée (colonne N-1 ou 31/12 d'un document suivant)
MEASURE Mesures[Part cumuls revises] =
    DIVIDE (
        CALCULATE ( COUNTROWS ( Fait_Indicateurs ), LEFT ( Fait_Indicateurs[Source_Cumul], 7 ) = "revisee" ),
        CALCULATE ( COUNTROWS ( Fait_Indicateurs ), NOT ISBLANK ( Fait_Indicateurs[Source_Cumul] ) )
    )

// [7. Qualité\Révisions | 0.0 %] Part des cumuls affichés qui viennent de la colonne 31/12 d'un document T1 à T3 suivant (le T4 de l'année suivante n'est pas encore publié)
MEASURE Mesures[Part 31-12 provisoires] =
    DIVIDE (
        CALCULATE ( COUNTROWS ( Fait_Indicateurs ), LEFT ( Fait_Indicateurs[Source_Cumul], 14 ) = "revisee_31-12_" ),
        CALCULATE ( COUNTROWS ( Fait_Indicateurs ), NOT ISBLANK ( Fait_Indicateurs[Source_Cumul] ) )
    )

// [7. Qualité\Révisions | #,0] Versions non retenues qui diffèrent de la valeur retenue de plus de 2 kDT
MEASURE Mesures[Nb revisions] =
    CALCULATE ( COUNTROWS ( Revisions ), ABS ( Revisions[Ecart_MDT] ) > 0.002 )

// [7. Qualité\Révisions | #,0] Valeurs initiales remplacées par une révision de plus de 2 % (sur le cumul)
MEASURE Mesures[Nb revisions importantes] =
    CALCULATE (
        COUNTROWS ( Revisions ),
        Revisions[version] = "initiale",
        Revisions[statut_revision] = "revision_importante"
    )

// [7. Qualité\Révisions | #,0] Valeurs initiales remplacées par une révision de 2 % au plus
MEASURE Mesures[Nb retraitements mineurs] =
    CALCULATE (
        COUNTROWS ( Revisions ),
        Revisions[version] = "initiale",
        Revisions[statut_revision] = "retraitement_mineur"
    )

// [7. Qualité\Révisions | #,0] Versions où une composante change sans que le total change (reclassement)
MEASURE Mesures[Nb reclassements] =
    CALCULATE ( COUNTROWS ( Revisions ), Revisions[statut_revision] = "reclassement" )

// [7. Qualité\Révisions | #,0.000] Somme des écarts valeur retenue − version non retenue (MDT)
MEASURE Mesures[Ecart revision MDT] =
    SUM ( Revisions[Ecart_MDT] )

// [7. Qualité\Révisions | #,0] Indicateurs × trimestres en rupture de série (période révisée de plus de 2 % sur le cumul)
MEASURE Mesures[Nb ruptures serie] =
    CALCULATE (
        COUNTROWS ( Fait_Indicateurs ),
        Fait_Indicateurs[Rupture_Trim] = "oui" || Fait_Indicateurs[Rupture_Cumul] = "oui"
    )

// [7. Qualité\Révisions | #,0] Valeurs absentes parce que le document est en image et non repris (aucune depuis la saisie des documents BTE)
MEASURE Mesures[Nb valeurs non disponibles] =
    CALCULATE ( COUNTROWS ( Revisions ), Revisions[statut_revision] = "non disponible (image)" )

// [7. Qualité\Contrôle annuel | #,0] Années × indicateurs dont la somme des 4 trimestres vaut le cumul annuel
MEASURE Mesures[Nb annees conformes] =
    CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "ok" )

// [7. Qualité\Contrôle annuel | #,0] Années en attente du document de l'année suivante (versions révisées pas encore toutes publiées)
MEASURE Mesures[Nb annees en attente] =
    CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "en attente de révision" )

// [7. Qualité\Contrôle annuel | #,0] Années × indicateurs avec un écart entre somme des trimestres et cumul annuel
MEASURE Mesures[Nb ecarts annuels] =
    CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "ecart" )

// [7. Qualité\Contrôle annuel | #,0] Écarts annuels dont la cause est écrite (docs/ecarts_annuels.csv : retraitement, erreur du document, reclassement, arrondi)
MEASURE Mesures[Nb ecarts expliques] =
    CALCULATE (
        COUNTROWS ( Controle_Annuel ),
        Controle_Annuel[statut] = "ecart",
        NOT ISBLANK ( Controle_Annuel[categorie_ecart] )
    )

// [7. Qualité\Contrôle annuel | #,0] Années × indicateurs avec un changement de méthode en cours d'année (rupture de série)
MEASURE Mesures[Nb ruptures annuelles] =
    CALCULATE ( COUNTROWS ( Controle_Annuel ), Controle_Annuel[statut] = "rupture de série" )

// [7. Qualité\Contrôle annuel | #,0.000] Somme des écarts annuels (somme des trimestres − cumul annuel, MDT)
MEASURE Mesures[Ecart annuel MDT] =
    CALCULATE ( SUM ( Controle_Annuel[Ecart_MDT] ), Controle_Annuel[statut] = "ecart" )

// [7. Qualité\États financiers | #,0] Valeurs des états financiers remplacées par une révision de plus de 2 %
MEASURE Mesures[Nb revisions importantes EF] =
    CALCULATE ( COUNTROWS ( Revisions_Etats_Financiers ), Revisions_Etats_Financiers[statut_revision] = "revision_importante" )
