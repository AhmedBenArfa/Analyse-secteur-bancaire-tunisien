// Auteur : Ahmed Ben Arfa
// Rentabilité et efficacité aux dates des états financiers (table calculée, jointure interne NATURALINNERJOIN) :
// une ligne par banque et par arrêté (30/06 et 31/12), avec le ROE et le ROA des états financiers et le coefficient
// d'exploitation harmonisé cumulé à la même date (semestre au 30/06, année au 31/12) des indicateurs trimestriels.
// NATURALINNERJOIN réunit deux tables sur leurs colonnes de même nom (banque, date_arrete) et ne garde que les
// lignes présentes des deux côtés : les trimestres sans états financiers (31/03, 30/09) disparaissent. Les colonnes
// de jointure sont des expressions (& "", DATE (…)) : leur lignage est cassé, sinon DAX refuserait de joindre deux
// colonnes venues de tables différentes du modèle. Les ROE et ROA sont calculés comme les mesures ROE et ROA (7.7),
// à partir des colonnes (LOOKUPVALUE) et non des mesures : une table calculée qui passerait par une mesure ne
// pourrait pas être reliée à Dim_Banque et à Dim_Date sans dépendance circulaire.
VAR Rentabilite =
    SELECTCOLUMNS (
        ADDCOLUMNS (
            FILTER ( Fait_Etats_Financiers, Fait_Etats_Financiers[code] = "RES_NET" ),
            "@Ouverture", DATE ( YEAR ( Fait_Etats_Financiers[date_arrete] ) - 1, 12, 31 ),
            "@ResultatAnnualise", Fait_Etats_Financiers[valeur_mdt] * Fait_Etats_Financiers[facteur_annualisation]
        ),
        "banque", Fait_Etats_Financiers[banque] & "",
        "date_arrete",
            DATE (
                YEAR ( Fait_Etats_Financiers[date_arrete] ),
                MONTH ( Fait_Etats_Financiers[date_arrete] ),
                DAY ( Fait_Etats_Financiers[date_arrete] )
            ),
        "ROE",
            VAR Fin =
                LOOKUPVALUE (
                    Fait_Etats_Financiers[valeur_mdt],
                    Fait_Etats_Financiers[banque], Fait_Etats_Financiers[banque],
                    Fait_Etats_Financiers[date_arrete], Fait_Etats_Financiers[date_arrete],
                    Fait_Etats_Financiers[code], "CAP_PROPRES_EF"
                )
            VAR Ouverture =
                LOOKUPVALUE (
                    Fait_Etats_Financiers[valeur_mdt],
                    Fait_Etats_Financiers[banque], Fait_Etats_Financiers[banque],
                    Fait_Etats_Financiers[date_arrete], [@Ouverture],
                    Fait_Etats_Financiers[code], "CAP_PROPRES_EF"
                )
            RETURN
                IF ( NOT ISBLANK ( Fin ) && NOT ISBLANK ( Ouverture ), DIVIDE ( [@ResultatAnnualise], ( Fin + Ouverture ) / 2 ) ),
        "ROA",
            VAR Fin =
                LOOKUPVALUE (
                    Fait_Etats_Financiers[valeur_mdt],
                    Fait_Etats_Financiers[banque], Fait_Etats_Financiers[banque],
                    Fait_Etats_Financiers[date_arrete], Fait_Etats_Financiers[date_arrete],
                    Fait_Etats_Financiers[code], "TOTAL_ACTIF"
                )
            VAR Ouverture =
                LOOKUPVALUE (
                    Fait_Etats_Financiers[valeur_mdt],
                    Fait_Etats_Financiers[banque], Fait_Etats_Financiers[banque],
                    Fait_Etats_Financiers[date_arrete], [@Ouverture],
                    Fait_Etats_Financiers[code], "TOTAL_ACTIF"
                )
            RETURN
                IF ( NOT ISBLANK ( Fin ) && NOT ISBLANK ( Ouverture ), DIVIDE ( [@ResultatAnnualise], ( Fin + Ouverture ) / 2 ) )
    )
VAR Efficacite =
    SELECTCOLUMNS (
        FILTER (
            Fait_Indicateurs,
            Fait_Indicateurs[code_indicateur] = "PNB" && NOT ISBLANK ( Fait_Indicateurs[Valeur_Cumul] )
        ),
        "banque", Fait_Indicateurs[banque] & "",
        "date_arrete",
            DATE (
                YEAR ( Fait_Indicateurs[date_arrete] ),
                MONTH ( Fait_Indicateurs[date_arrete] ),
                DAY ( Fait_Indicateurs[date_arrete] )
            ),
        "Coef_Cumul",
            VAR Personnel =
                LOOKUPVALUE (
                    Fait_Indicateurs[Valeur_Cumul],
                    Fait_Indicateurs[banque], Fait_Indicateurs[banque],
                    Fait_Indicateurs[date_arrete], Fait_Indicateurs[date_arrete],
                    Fait_Indicateurs[code_indicateur], "FRAIS_PERS"
                )
            VAR Generales =
                LOOKUPVALUE (
                    Fait_Indicateurs[Valeur_Cumul],
                    Fait_Indicateurs[banque], Fait_Indicateurs[banque],
                    Fait_Indicateurs[date_arrete], Fait_Indicateurs[date_arrete],
                    Fait_Indicateurs[code_indicateur], "CHG_GEN"
                )
            RETURN
                IF (
                    NOT ISBLANK ( Personnel ) && NOT ISBLANK ( Generales ),
                    DIVIDE ( Personnel + Generales, Fait_Indicateurs[Valeur_Cumul] )
                )
    )
RETURN
    NATURALINNERJOIN ( Rentabilite, Efficacite )
